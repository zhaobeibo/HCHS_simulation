overall_best <- rankings_data %>%
group_by(scenario, scenario_desc) %>%
summarise(
total_comparisons = n(),
avg_rank_overall = mean(rank),
best_rank_count = sum(rank == 1),
best_rank_pct = (best_rank_count / total_comparisons) * 100,
avg_empirical_se = mean(`Empirical SE`),
.groups = "drop"
) %>%
arrange(avg_rank_overall)
return(list(
by_outcome = best_by_outcome,
by_correlation = best_by_correlation,
by_rr_method = best_by_rr_method,
overall = overall_best
))
}
# Function to create detailed parameter-specific analysis
create_parameter_specific_analysis <- function(rankings_data) {
parameter_tables <- list()
for (param in unique(rankings_data$parameter)) {
param_data <- rankings_data %>% filter(parameter == param)
# Create comprehensive parameter table showing all combinations
param_summary <- param_data %>%
group_by(outcome_type, correlation, weight_method, scenario, scenario_desc) %>%
summarise(
rank = mean(rank),
empirical_se = mean(`Empirical SE`),
.groups = "drop"
) %>%
unite("outcome_corr", outcome_type, correlation, sep = "_") %>%
unite("method_scenario", weight_method, scenario, sep = "_S") %>%
pivot_wider(
names_from = outcome_corr,
values_from = c(rank, empirical_se),
names_sep = "_"
) %>%
arrange(method_scenario)
parameter_tables[[paste0(param, "_Comprehensive")]] <- param_summary
# Create best scenario for each method-outcome-correlation combination
param_best <- param_data %>%
group_by(outcome_type, correlation, weight_method) %>%
slice_min(rank, n = 1) %>%
select(outcome_type, correlation, weight_method, scenario_desc, rank, `Empirical SE`) %>%
arrange(outcome_type, correlation, weight_method)
parameter_tables[[paste0(param, "_Best_Scenarios")]] <- param_best
}
return(parameter_tables)
}
