81804  *************************************************************************
81804! ********************************
81805  
81806          PROGRAM NAME: regress_sudaan.sas
81807  
81808          PROGRAMMER: AQA
81809  
81810          DESCRIPTION:
81811  
81812          VERSION CONTROL:
81813                          - 20FEB25: Initialize the code
81814                          - 30may25: Uncomment the miss_ind_mar = 0 so we
81814! obtain the complete data case
81815  
81816  *************************************************************************
81816! ********************************;
81817  
81818  * Run sudaan models for the 100 files;
81819  %macro regress_sudaan(start=1, end=100, corr=, corr_full=);
81820    %do i = &start %to &end;
81821  
81822      * use only available data;
81823      proc sql;
81824          create table temp_&i. as
81825          select *
81826          from sample.samplemiss_&i.
81827          where miss_ind_mar = 0; /* Select only records with no
81827! missingness */
81828      quit;
81829  
81830      * order data;
81831      proc sort data = samplemiss_&i._;
81832          by strat_recoded bgid hhid subid;
81833      run;
81834  
81835      * Fit regress model from sudaan using &corr matrix;
81836          * In a simulation group meeting it was requested to use hhid as
81836! PSUs instead of bgid;
81837      options pagesize=60 linesize=80;
81838      proc regress data = samplemiss_&i._ filetype=sas r=&corr_full
81838! semethod=zeger;
81839          %if  &corr. = exch %then %do;
81840              nest strat_recoded hhid / psulev=2 ;
81841          %end;
81842          %else %do;
81843              nest strat_recoded hhid;
81844          %end;
81845          weight bghhsub_s2;
81846          model y_gfr = x17 x12 x18 y_bmi age_strat_new x6;
81847          output beta sebeta p_beta t_beta / filename=betas_&corr._&i._
81847! filetype=sas replace;
81848      run;
81849  
81850      * Append parameter names to sudaan output;
81851      data dt_b_s2.betas_&corr._&i;
81852          merge betas_&corr._&i._(rename=(BETA=Estimate SEBETA=Stderr
81852! P_BETA=ProbZ t_beta=t)) parms;
81853          by modelrhs;
81854          length parm $ 20;
81855          drop procnum modelno modelrhs;
81856      run;
81857  
81858    %end;
81859  %mend regress_sudaan;
81860  
81861  * Create dataset with parms labels;
81862  data parms;
81863      length Parm $ 15;
81864      input modelrhs parm $;
81865      datalines;

NOTE: The data set WORK.PARMS has 7 observations and 2 variables.
NOTE: DATA statement used (Total process time):
      real time           0.01 seconds
      cpu time            0.00 seconds
      

81873  ;
81874  run;
81875  
81876  /* Execute the macro for exchangeable correlation matrix */
81877  %regress_sudaan(corr=ind, corr_full=independent);
