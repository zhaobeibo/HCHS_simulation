      real time           1.12 seconds
      cpu time            0.18 seconds
      

41   
42   
43   %macro combine_con_betas(start=, end=, corr=, corr_full = , rr=,
44                          input_lib=, pop_lib=dt_betas, output_lib=outpath)
44 ! ;
45   
46       /* Create a temporary dataset to hold all existing files */
47       data merge_betas;
48           /* Initialize empty dataset with correct structure */
49           length parm $20;
50           if 0; /* This creates structure but no observations */
51       run;
52   
53       /* Counter for successful merges */
54       %let merge_count = 0;
55   
56       /* Loop through each file number and check if it exists */
57       %do i = &start %to &end;
58           /* Check if dataset exists using SASHELP.VTABLE or by attempting
58 !  to open */
59           %if %sysfunc(exist(&input_lib..&corr.&rr.&i.)) %then %do;
60               /* Dataset exists, append it */
61               data merge_betas;
62                   set merge_betas &input_lib..&corr.&rr.&i.;
63                   if parm = 'intercept' then parm = 'Intercept';
64               run;
65               %let merge_count = %eval(&merge_count + 1);
66               %put NOTE: Successfully merged dataset
66 ! &input_lib..&corr.&rr.&i. (File &merge_count);
67           %end;
68           %else %do;
69               %put WARNING: Dataset &input_lib..&corr.&rr.&i. does not
69 ! exist - skipping;
70           %end;
71       %end;
72   
73       %put NOTE: Total datasets merged: &merge_count out of %eval(&end -
73 ! &start + 1) possible files;
74   
75       /* Check if we have any data to process */
76       %let dsid = %sysfunc(open(merge_betas));
77       %let nobs = %sysfunc(attrn(&dsid, nobs));
78       %let rc = %sysfunc(close(&dsid));
79   
80       %if &nobs = 0 %then %do;
81           %put ERROR: No datasets found to merge for
81 ! &input_lib..&corr.&rr. - exiting macro;
82           %return;
83       %end;
84   
85       /* Append the true value coming from population estimates */
86       proc sql;
87           create table betas_samp_pop as
88           select a.*, b.estimate as true
89           from merge_betas as a
90           right join
91           &pop_lib..betas_pop_&corr. as b
92           on a.parm=b.parm;
93       quit;
94   
95       /* Compute 95% confidence intervals */
96       data betas_samp_pop;
97           set betas_samp_pop;
98           uppercl = Estimate + 1.96 * Stderr;
99           lowercl = Estimate - 1.96 * Stderr;
100      run;
101  
102      /* Estimate quantities of interest: bias, ... */
103      data betas_samp_pop_;
104          set betas_samp_pop;
105          /* Calculate statistics to summarize */
106          inci = (uppercl >= true & lowercl <= true);
107          bias = estimate - true;
108          relbias = bias / true;
109          /* PROBT */
110          rejecth0 = (abs(t) > quantile('NORMAL',.975));
111      run;
112  
113      /* Calculate summary statistics */
114      proc means data=betas_samp_pop_ noprint nway;
115          class parm;
116          var true estimate bias relbias stderr inci rejecth0;
117          output out=output_1 mean(true estimate bias relbias stderr inci
118                  rejecth0)=true estimate empbias relbias estse coverage
119                  prejecth0 std(estimate)=empse;
120      run;
121  
122      /* Final calculations */
123      data output;
124          set output_1;
125          relse = estse/empse - 1;
126          /* Add information about number of files merged */
127          files_merged = &merge_count;
128      run;
129  
130      /* Save output dataset */
131      data &output_lib..&input_lib._&corr.&rr.;
132          set output;
133      run;
134  
135      /* Clean up temporary datasets */
136      proc datasets library=work nolist;
137          delete merge_betas betas_samp_pop betas_samp_pop_ output_1
137! output;
138      quit;
139  
140  %mend combine_con_betas;
141  
142  
143  * s1 - MI scenarios;
144  * miss_ind_mar scenarios;
145  /*%combine_con_betas(start=1, end=100, corr=ind, corr_full=independent,
145! rr=_double_rr_, */
146  /*                 input_lib=test1);*/
147  
148  %combine_con_betas(start=1, end=100, corr=ind, corr_full=independent,
148! rr=_rr_glm_,
149                   input_lib=missout);

