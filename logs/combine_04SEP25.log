37   ************************************************************************
37 ! *********************************
38   
39           PROGRAM NAME: combine_sudaan.sas
40           PROGRAMMER: Beibo Zhao (updated from AQA)
41           DESCRIPTION: Combine results and calculate performance metrics
41 ! for HCHS V3 simulation
42           VERSION CONTROL:
43                           - 24APR25: Initialize the code (AQA)
44                           - Aug2025: Updated for consistency with R
44 ! simulation framework (BZ)
45                           - Modified: Handle missing datasets from 1-1000,
45 !  skip non-existent files
46   ************************************************************************
46 ! *********************************;
47   
48   %macro combine_con_betas(start=, end=, corr=, corr_full = , rr=,
49                          input_lib=, pop_lib=dt_betas, output_lib=outpath)
49 ! ;
50   
51       /* Create a temporary dataset to hold all existing files */
52       data merge_betas;
53           /* Initialize empty dataset with correct structure */
54           length parm $20;
55           if 0; /* This creates structure but no observations */
56       run;
57   
58       /* Counter for successful merges */
59       %let merge_count = 0;
60   
61       /* Loop through each file number and check if it exists */
62       %do i = &start %to &end;
63           /* Check if dataset exists using SASHELP.VTABLE or by attempting
63 !  to open */
64           %if %sysfunc(exist(&input_lib..&corr.&rr.&i.)) %then %do;
65               /* Dataset exists, append it */
66               data merge_betas;
67                   set merge_betas &input_lib..&corr.&rr.&i.;
68                   if parm = 'intercept' then parm = 'Intercept';
69               run;
70               %let merge_count = %eval(&merge_count + 1);
71               %put NOTE: Successfully merged dataset
71 ! &input_lib..&corr.&rr.&i. (File &merge_count);
72           %end;
73           %else %do;
74               %put WARNING: Dataset &input_lib..&corr.&rr.&i. does not
74 ! exist - skipping;
75           %end;
76       %end;
77   
78       %put NOTE: Total datasets merged: &merge_count out of %eval(&end -
78 ! &start + 1) possible files;
79   
80       /* Check if we have any data to process */
81       %let dsid = %sysfunc(open(merge_betas));
82       %let nobs = %sysfunc(attrn(&dsid, nobs));
83       %let rc = %sysfunc(close(&dsid));
84   
85       %if &nobs = 0 %then %do;
86           %put ERROR: No datasets found to merge for
86 ! &input_lib..&corr.&rr. - exiting macro;
87           %return;
88       %end;
89   
90       /* Append the true value coming from population estimates */
91       proc sql;
92           create table betas_samp_pop as
93           select a.*, b.estimate as true
94           from merge_betas as a
95           right join
96           &pop_lib..betas_pop_&corr. as b
97           on a.parm=b.parm;
98       quit;
99   
100      /* Compute 95% confidence intervals */
101      data betas_samp_pop;
102          set betas_samp_pop;
103          uppercl = Estimate + 1.975 * Stderr;
104          lowercl = Estimate - 1.975 * Stderr;
105      run;
106  
107      /* Estimate quantities of interest: bias, ... */
108      data betas_samp_pop_;
109          set betas_samp_pop;
110          /* Calculate statistics to summarize */
111          inci = (uppercl >= true & lowercl <= true);
112          bias = estimate - true;
113          relbias = bias / true;
114          /* PROBT */
115          rejecth0 = (abs(t) > quantile('NORMAL',.975));
116      run;
117  
118      /* Calculate summary statistics */
119      proc means data=betas_samp_pop_ noprint nway;
120          class parm;
121          var true estimate bias relbias stderr inci rejecth0;
122          output out=output_1 mean(true estimate bias relbias stderr inci
123                  rejecth0)=true estimate empbias relbias estse coverage
124                  prejecth0 std(estimate)=empse;
125      run;
126  
127      /* Final calculations */
128      data output;
129          set output_1;
130          relse = estse/empse - 1;
131          /* Add information about number of files merged */
132          files_merged = &merge_count;
133      run;
134  
135      /* Save output dataset */
136      data &output_lib..&input_lib._&corr.&rr.;
137          set output;
138      run;
139  
140      /* Clean up temporary datasets */
141      proc datasets library=work nolist;
142          delete merge_betas betas_samp_pop betas_samp_pop_ output_1
142! output;
143      quit;
144  
145  %mend combine_con_betas;
146  
147  
148  * s1 - MI scenarios;
149  * miss_ind_mar scenarios;
150  %combine_con_betas(start=1, end=1000, corr=ind, corr_full=independent,
150! rr=_rr_glm_,
151                   input_lib=s1);

