1365  * Macro that fit a SUDAAN model with a continuous normal response;
1366  %macro pop(corr=, corr_full=);
1367      options pagesize=60 linesize=80;
1368      proc regress data = pop filetype=sas r=&corr_full semethod=zeger;
1369          %if &corr. = exch %then %do;
1370              nest strat_recoded bgid hhid / psulev=2 ;
1371          %end;
1372          %else %do;
1373              nest strat_recoded bgid hhid;
1374          %end;
1375          weight _one_;
1376          model y_gfr = x17 x12 x18 y_bmi age_strat_new x6;
1377          output beta sebeta p_beta t_beta / filename=betas_&corr. filetype=sas replace;
1378      run;
1379      * Append parameter names to sudaan output;
1380      data dt_betas.betas_pop_&corr;
1381          merge betas_&corr.(rename=(BETA=Estimate SEBETA=Stderr P_BETA=ProbZ t_beta=t))
1381! parms;
1382          by modelrhs;
1383          length parm $ 20;
1384          format Estimate Stderr 12.4;
1385          drop procnum modelno modelrhs;
1386      run;
