699    
700    %macro impute_sudaan(start=, end=, corr=, corr_full=, rr=, miss=);
701      %do i = &start. %to &end.;
702    
703        data samplemiss_&i._;
704            set sample.samplemiss_&i;
705    
706            /* weight adjusted for nomresponse */
707            bghhsub_s2_nr = bghhsub_s2/ &rr.;
708    
709            where &miss. = 0;
710        run;
711    
712    
713        /* Order data */
714        proc sort data = samplemiss_&i._;
715            by strat_recoded bgid hhid subid;
716        run;
717    
718    
719        * Fit regress model from sudaan using &corr matrix;
720            * In a simulation group meeting it was requested to use hhid as
720  ! PSUs instead of bgid;
721        options pagesize=60 linesize=80;
722        proc regress data = samplemiss_&i._ filetype=sas r=&corr_full
722  ! semethod=zeger;
723            %if  &corr. = exch %then %do;
724                nest strat_recoded hhid / psulev=2 ;
725            %end;
726            %else %do;
727                nest strat_recoded hhid;
728            %end;
729            weight bghhsub_s2_nr;    *use visit-specific adjusted weight;
730            model y_gfr = x17 x12 x18 y_bmi age_strat_new x6;
731            output beta sebeta p_beta t_beta / filename=betas_&corr._&i._
731  ! filetype=sas replace;
732        run;
733    
734        * Append parameter names to sudaan output;
735        data s6.&corr._&rr._&i;
736            merge betas_&corr._&i._(rename=(BETA=Estimate SEBETA=Stderr
736  ! P_BETA=ProbZ t_beta=t)) parms;
737            by modelrhs;
738            length parm $ 20;
739            format Estimate Stderr 12.4;
740            drop procnum modelno modelrhs;
741        run;
742    
743    
744      %end;
745    %mend impute_sudaan;
