47       ;
48   run;
49   
50   %macro impute_sudaan(start=, end=, corr=, corr_full=, rr=, miss=
50 ! ,nimpute=5);
51     %do i = &start. %to &end.;
52               data samp;
53                   set sample.samplemiss_&i;
54   
55                   /* weight adjusted for nomresponse */
56                   bghhsub_s2_nr = bghhsub_s2/ &rr.;
57   
58                   where &miss. = 0;
59               run;
60   
61               /* Sort samp by subid for merging */
62               proc sort data = samp;
63                   by subid;
64               run;
65   
66               /* Step 1: Create a dataset with subid in V3 */
67               proc sql;
68                  create table valid_subid as
69                  select distinct subid
70                  from samp
71                  where v_num = 3;
72               quit;
73   
74               /* Sort valid_subid by subid for merging */
75               proc sort data = valid_subid;
76                   by subid;
77               run;
78   
79               /* Step 2: Merge samp with valid_subid to keep only valid
79 ! subids */
80               data samp_filtered;
81                  merge samp(in=a) valid_subid(in=b);
82                  by subid;
83                  if b;  /* Only keep records from samp where subid is in
83 ! valid_subid */
84               run;
85   
86               /* Step 3: Create a dataset with the value of bghhsub_s2_nr
86 ! for v_num = 3 for each subid */
87               proc sql;
88                  create table temp as
89                  select subid, bghhsub_s2_nr as bghhsub_s2_v3_nr
90                  from samp_filtered
91                  where v_num = 3;
92               quit;
93   
94               /* Step 4: Merge the new variable back into the filtered
94 ! dataset */
95               data samplemiss_&i._;
96                  merge samp_filtered temp;
97                  by subid;
98               run;
99   
100              /* Order data */
101              proc sort data = samplemiss_&i._;
102                  by strat_recoded bgid hhid subid;
103              run;
104  
105  
106              /* Transform from long to wide */
107                  /* This step is the preparation step for multiple
107! imputation */
108              data samp_1(rename=(x6=x6_1 y_bmi=y_bmi_1 y_gfr=y_gfr_1
108! bghhsub_s2_nr=w_nr_1))
109                      samp_2(rename=(x6=x6_2 y_bmi=y_bmi_2 y_gfr=y_gfr_2
109! bghhsub_s2_nr=w_nr_2))
110                      samp_3(rename=(x6=x6_3 y_bmi=y_bmi_3 y_gfr=y_gfr_3
110! bghhsub_s2_nr=w_nr_3));
111                  set samplemiss_&i._;
112                  if v_num = 1 then output samp_1;
113                  else if v_num = 2 then output samp_2;
114                  else if v_num = 3 then output samp_3;
115              run;
116  
117              * Sort the 3 datasets;
118              proc sort data = samp_1; by subid; run;
119              proc sort data = samp_2; by subid; run;
120              proc sort data = samp_3; by subid; run;
121  
122                  * merging the 3 new datasets;
123              data samp_wide;
124                  merge samp_1-samp_3;
125                  by subid;
126              run;
127  
128                  * sort the output datasets;
129              proc sort data = samp_wide;
130                   by subid;
131              run;
132  
133                  * obtain the # of missing values by var ;
134              proc means data = samp_wide noprint;
135                   var  x17 x12 x18 y_bmi_1-y_bmi_3 age_strat_new
136                              x6_2-x6_3 y_gfr_1-y_gfr_3
137                              x14 w_nr_1 w_nr_2 w_nr_3;
138                  output out= mi_miss nmiss=;
139              run;
140  
141                  * transpose the values from proc means;
142              proc transpose data = mi_miss(drop=_TYPE_ _FREQ_)
142! out=mi_long;
143              run;
144  
145                  * sort the values by # missing;
146              proc sort data = mi_long;
147                      by col1;
148              run;
149  
150              proc sql noprint;
151                      select distinct _name_ into:var separated by ' '
151! from mi_long;
152              quit;
153              %put &var.;
154  
155              data samp_wide;
156                  set samp_wide;
157                  strat_psu = cats(strat_recoded,bgid);
158              run;
159  
160              proc mi data=samp_wide seed=2021 nimpute=&nimpute
160! out=samp_complete;
161                  class strat_psu;
162                  fcs reg(x6_2-x6_3 y_gfr_2-y_gfr_3 y_bmi_2-y_bmi_3);
163                  var &var. strat_psu;
164              run;
165  
166                  /* Transform the imputed datasets from wide format to
166! long */
167              data samp_long;
168                      set samp_complete;
169                      v_num = 1;
170                      x6 = x6_1;
171                      y_bmi = y_bmi_1;
172                      y_gfr = y_gfr_1;
173                      bghhsub_s2_nr = w_nr_1;
174                      output;
175  
176                      v_num = 2;
177                      x6 = x6_2;
178                      y_bmi = y_bmi_2;
179                      y_gfr = y_gfr_2;
180                      bghhsub_s2_nr = w_nr_2;
181                      output;
182  
183                      v_num = 3;
184                      x6 = x6_3;
185                      y_bmi = y_bmi_3;
186                      y_gfr = y_gfr_3;
187                      bghhsub_s2_nr = w_nr_3;
188                      output;
189              run;
190  
191                      * Fit regress model from sudaan using corr matrix;
192                  * Looping over the 5 simulated datasets;
193                  %do j = 1 %to &nimpute;
194                      data temp;
195                          set samp_long;
196                          if _imputation_ = &j;
197                      run;
198                  proc sort data = temp;
199                      by strat_recoded bgid hhid subid;
200                  run;
201                      options pagesize=60 linesize=80;
202                      proc regress data = temp filetype=sas r=&corr_full
202! semethod=zeger;
203                          %if &corr. = exch %then %do;
204                              nest strat_recoded hhid / psulev=2 ;
205                          %end;
206                          %else %do;
207                              nest strat_recoded hhid;
208                          %end;
209                          weight bghhsub_s2_v3_nr;
210                          model y_gfr = x17 x12 x18 y_bmi age_strat_new x6
210! ;
211                          output beta sebeta p_beta t_beta /
211! filename=betas_mi_&corr._&i._&j filetype=sas replace;
212                      run;
213  
214                      data betas_mi_&corr._&i._&j;
215                          merge vars_labels betas_mi_&corr._&i._&j ;
216                          by modelrhs;
217                          _imputation_ = &j;
218                          ClassVal0 = '';
219                          DF = 1;
220                          rename beta = Estimate sebeta = StdErr p_beta =
220! ProbChisq t_beta = WaldChisq;
221                          drop procnum modelno modelrhs;
222                      run;
223                  %end;
224          * merging the 10 datasets;
225          data outparms;
226              set betas_mi_&corr._&i._1 - betas_mi_&corr._&i._&nimpute.;
227          run;
228          * combine estimates;
229          proc mianalyze parms = outparms;
230              modeleffects intercept x17 x12 x18 y_bmi age_strat_new x6;
231              ods output ParameterEstimates = betas_mi_&corr._&i;
232          run;
233          data s3.&corr._&rr._&i;
234                          SET betas_mi_&corr._&i(RENAME=(UCLMEAN = UPPERCL
234!  LCLMEAN=LOWERCL ));
235          run;
236    %end;
237  %mend impute_sudaan;
238  
239  * miss_ind_mar;
240  %impute_sudaan(start=1, end=100, corr=ind, corr_full=independent,
240! rr=rr_glm, miss= miss_ind_mar);

