50   
51   %macro impute_sudaan(start=, end=, corr=, corr_full=, rr=, miss=);
52     %do i = &start. %to &end.;
53   
54       data samplemiss_&i._;
55           set sample.samplemiss_&i;
56   
57           /* weight adjusted for nomresponse */
58           bghhsub_s2_nr = bghhsub_s2/ &rr.;
59   
60           where &miss. = 0;
61       run;
62   
63   
64       /* Order data */
65       proc sort data = samplemiss_&i._;
66           by strat_recoded bgid hhid subid;
67       run;
68   
69   * Fit rlogist model from sudaan using &corr matrix;
70           * In a simulation group meeting it was requested to use hhid as
70 ! PSUs instead of bgid;
71       options pagesize=60 linesize=80;
72       proc rlogist data = samplemiss_&i._ filetype=sas r=&corr_full
72 ! semethod=zeger;
73           %if  &corr. = exch %then %do;
74               nest strat_recoded hhid / psulev=2 ;
75           %end;
76           %else %do;
77               nest strat_recoded hhid;
78           %end;
79           weight bghhsub_s2_nr;    *use visit-specific adjusted weight;
80           model y_bin_gfr = x17 x12 x18 y_bmi age_strat_new x6;
81           output beta sebeta p_beta t_beta / filename=betas_&corr._&i._
81 ! filetype=sas replace;
82       run;
83   
84       * Append parameter names to sudaan output;
85       data bs6.&corr._&rr._&i;
86           merge betas_&corr._&i._(rename=(BETA=Estimate SEBETA=Stderr
86 ! P_BETA=ProbZ t_beta=t)) parms;
87           by modelrhs;
88           length parm $ 20;
89           format Estimate Stderr 12.4;
90           drop procnum modelno modelrhs;
91       run;
92   
93   
94     %end;
