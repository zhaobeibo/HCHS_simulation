620    
621    %macro combine_betas(start=1, end=1000, corr=);
622    * merge files containing beta estimates using sample data;
623    data merge_betas;
624        set dt_b_s2.&corr._&start. - dt_b_s2.&corr._&end.;
625    run;
626    
627    * append the true value coming from population estimates;
628    proc sql;
629         create table betas_samp_pop as
630           select a.*, b.estimate as true
631           from
632           merge_betas as a
633           right join
634           dt_betas.betas_pop_&corr. as b
635           on a.parm=b.parm;
636    quit;
637    
638    * Compute 95% confidence intervals;
639    data betas_samp_pop;
640        set betas_samp_pop;
641        uppercl = Estimate + 1.965 * Stderr;
642        lowercl = Estimate - 1.965 * Stderr;
643    run;
644    
645    * Estimate quantities of interest: bias, ...;
646    data betas_samp_pop_;
647                    set betas_samp_pop;
648                    /*calculate statistics to summarize*/
649                    inci=(uppercl>=true & lowercl<=true);
650                    bias=estimate-true;
651                    relbias=bias/true;
652                    /*PROBT*/
653                    rejecth0=(abs(t)>quantile('NORMAL',.975));
654    run;
655    
656    proc means data=betas_samp_pop_
657                    noprint nway;
658                    class parm;
659                    var true estimate bias relbias stderr inci rejecth0;
660                    output out=output_1 mean(true estimate bias relbias
660  ! stderr inci
661                            rejecth0)=true estimate empbias relbias estse
661  ! coverage
662                            prejecth0 std(estimate)=empse;
663    run;
664    
665    
666    data output;
667          set output_1;
668          relse=estse/empse-1;
669    run;
670    
671    ods rtf file="&homepath./output/reports/s2_combine_&corr._&sysdate..rtf"
671  ! style=journal bodytitle;
672            proc print data=output noobs label;
673            var parm true estimate empbias relbias empse estse relse coverage
673  !  prejecth0;
674            label parm='Effect' true='True Value' estimate='Estimate'
675                            empbias='Empirical Bias' relbias='Relative Bias'
676                            empse='Empirical SE' estse='Estimated SE'
677                            coverage='Coverage' prejecth0='P(reject H0)'
678                            relse='Relative SE difference';
679    run;
680    ods rtf close;
681    %mend combine_betas;
682    
683    %combine_betas(corr=exch);

