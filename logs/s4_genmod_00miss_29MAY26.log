17825  /*============================================================*
17826   | 2) Standardize GENMOD output to match downstream merge       |
17827   |    - Ignore Level1 entirely                                  |
17828   |    - Keep only rows with non-missing Z (drops ref rows)       |
17829   |    - For age_strat_new this keeps the estimable row (Z!=.)    |
17830   *============================================================*/
17831  
17832  data betas_&corr._&i._prep;
17833    set betas_&corr._&i;
17834  
17835    length Parameter $32;
17836  
17837    /* Map GENMOD name -> Parameter used for merge */
17838    Parameter = strip(Parm);
17839  
17840    /* Keep only parameters we care about */
17841    if upcase(Parameter) not in
17841! ("INTERCEPT","X17","X12","X18","Y_BMI","AGE_STRAT_NEW","X6") then
17841! delete;
17842  
17843    /* Keep only estimable rows (reference rows have Z = .) */
17844    if missing(Z) then delete;
17845  
17846    /* Create t-stat placeholder (combine code expects 't') */
17847    t = Z;
17848  
17849    keep Parameter Estimate Stderr ProbZ t;
17850  run;
17851  
17852  /* Sort for merge */
17853  proc sort data=betas_&corr._&i._prep; by Parameter; run;
17854  proc sort data=parms;                 by Parameter; run;
17855  
17856  /* Final output dataset matches your combine macro expectations */
17857  data missout.&corr._rr_glm_&i;
17858    merge betas_&corr._&i._prep(in=a)
17859          parms(in=b);
17860    by Parameter;
17861    if a;
17862  
17863    format Estimate Stderr 12.4;
17864    keep modelrhs parm Estimate Stderr ProbZ t;
17865  run;
17866  
17867  
17868    %end;
17869  
