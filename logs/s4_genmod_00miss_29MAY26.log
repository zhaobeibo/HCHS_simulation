17788  
17789      /*============================*
17790       | 0) Read sample + recode    |
17791       *============================*/
17792      data samplemiss_&i;
17793        set samplemiss_&i._raw1;
17794  
17795        where miss_ind_mar = 0; /* remove missing visits */
17796  
17797        if strat in (1,5) then strat_recoded = 1;
17798        else if strat in (2,6) then strat_recoded = 2;
17799        else if strat in (3,7) then strat_recoded = 3;
17800        else if strat in (4,8) then strat_recoded = 4;
17801  
17802          if upcase(strip(age_strat)) = 'TRUE' then age_strat_new = 1;
17803          else if upcase(strip(age_strat)) = 'FALSE' then age_strat_new
17803! = 0;
17804          else age_strat_new = .;
17805      run;
17806  
17807      proc sort data=samplemiss_&i;
17808        by strat_recoded bgid hhid subid;
17809      run;
17810  
17811      ods exclude all;
17812      ods output GEEEmpPEst = betas_&corr._&i;   /* robust (empirical)
17812! PE table */
17813      proc genmod data=samplemiss_&i ;
17814        class hhid age_strat_new(ref = '0');
17815        weight &rr_glm.;
17816        model y_gfr = x17 x12 x18 y_bmi age_strat_new x6
17817          / dist=normal link=identity;
17818        repeated subject=hhid / type=ind ;
17819      run;
17820      ods output close;
17821      ods exclude none;
