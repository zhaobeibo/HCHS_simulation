17704  %macro impute_genmod(start=, end=, corr = , rr_glm = );
17705  
17706  
17707    %do i = &start %to &end;
17708  
17709  
17710      /*============================*
17711       | 0a) Import CSV + handle NA |
17712       *============================*/
17713      proc import datafile="&datapath./samplemiss_&i..csv"
17714          out=samplemiss_&i._raw
17715          dbms=csv
17716          replace;
17717          guessingrows=max;
17718      run;
17719  
17720  
17721      /*========================================================*
17722   | Semi-automatic conversion of character vars containing |
17723   | "NA" to numeric vars with SAS missing (.)              |
17724   *========================================================*/
17725  
17726  /* 1) Get all character variable names */
17727  proc contents data=samplemiss_&i._raw out=_vars_(keep=name type)
17727! noprint;
17728  run;
17729  
17730  proc sql noprint;
17731      select name
17732      into :char_vars separated by ' '
17733      from _vars_
17734      where type = 2;
17735  quit;
17736  
17737  /* 2) Find which character variables contain at least one "NA" */
17738  %macro find_na_vars;
17739      %global na_vars;
17740      %let na_vars=;
17741  
17742      %let n=%sysfunc(countw(&char_vars));
17743      %do j=1 %to &n;
17744          %let v=%scan(&char_vars, &j);
17745  
17746          proc sql noprint;
17747              select count(*)
17748              into :has_na trimmed
17749              from samplemiss_&i._raw
17750              where strip(&v) = "NA";
17751          quit;
17752  
17753          %if &has_na > 0 %then %do;
17754              %let na_vars=&na_vars &v;
17755          %end;
17756      %end;
17757  %mend;
17758  
17759  %find_na_vars
17760  
17761  %put NOTE: Variables containing NA = &na_vars;
17762  
17763  /* 3) Convert only those variables to numeric */
17764  data samplemiss_&i._raw1;
17765      set samplemiss_&i._raw;
17766  
17767      %let n_na=%sysfunc(countw(&na_vars));
17768  
17769      %do j=1 %to &n_na;
17770          %let v=%scan(&na_vars, &j);
17771          &v._num = input(strip(&v), best.);
17772      %end;
17773  
17774      drop
17775      %do j=1 %to &n_na;
17776          %let v=%scan(&na_vars, &j);
17777          &v
17778      %end;
17779      ;
17780  
17781      rename
17782      %do j=1 %to &n_na;
17783          %let v=%scan(&na_vars, &j);
17784          &v._num = &v
17785      %end;
