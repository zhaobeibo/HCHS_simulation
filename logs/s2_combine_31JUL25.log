395   
396   %macro combine_betas(start=1, end=100, corr=);
397   * merge files containing beta estimates using sample data;
398   data merge_betas;
399       set dt_b_s2.betas_&corr._&start. - dt_b_s2.betas_&corr._&end.;
400   run;
401   
402   * append the true value coming from population estimates;
403   proc sql;
404        create table betas_samp_pop as
405          select a.*, b.estimate as true
406          from
407          merge_betas as a
408          right join
409          dt_betas.betas_pop_&corr. as b
410          on a.parm=b.parm;
411   quit;
412   
413   * Compute 95% confidence intervals;
414   data betas_samp_pop;
415       set betas_samp_pop;
416       uppercl = Estimate + 1.965 * Stderr;
417       lowercl = Estimate - 1.965 * Stderr;
418   run;
419   
420   * Estimate quantities of interest: bias, ...;
421   data betas_samp_pop_;
422                   set betas_samp_pop;
423                   /*calculate statistics to summarize*/
424                   inci=(uppercl>=true & lowercl<=true);
425                   bias=estimate-true;
426                   relbias=bias/true;
427                   /*PROBT*/
428                   rejecth0=(abs(t)>quantile('NORMAL',.975));
429   run;
430   
431   proc means data=betas_samp_pop_
432                   noprint nway;
433                   class parm;
434                   var true estimate bias relbias stderr inci rejecth0;
435                   output out=output_1 mean(true estimate bias relbias stderr
435 !  inci
436                           rejecth0)=true estimate empbias relbias estse
436 ! coverage
437                           prejecth0 std(estimate)=empse;
438   run;
439   
440   
441   data output;
442         set output_1;
443         relse=estse/empse-1;
444   run;
445   
446   ods rtf file="&homepath./output/reports/s2_combine_&corr._&sysdate..rtf"
446 ! style=journal bodytitle;
447           proc print data=output noobs label;
448           var parm true estimate empbias relbias empse estse relse coverage
448 ! prejecth0;
449           label parm='Effect' true='True Value' estimate='Estimate'
450                           empbias='Empirical Bias' relbias='Relative Bias'
451                           empse='Empirical SE' estse='Estimated SE'
452                           coverage='Coverage' prejecth0='P(reject H0)'
453                           relse='Relative SE difference';
454   run;
455   ods rtf close;
456   %mend combine_betas;
457   
458   %combine_betas(corr=exch);

