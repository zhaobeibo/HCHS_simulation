47       ;
48   run;
49   
50   %macro impute_sudaan_binary(start=, end=, corr=, corr_full=, rr=, miss=
50 ! ,nimpute=5);
51     %do i = &start. %to &end.;
52               data samp;
53                   set sample.samplemiss_&i;
54   
55                   /* weight adjusted for nonresponse */
56                   bghhsub_s2_nr = bghhsub_s2/ &rr.;
57   
58                   where &miss. = 0;
59               run;
60   
61               /* Transform from long to wide */
62                   /* This step is the preparation step for multiple
62 ! imputation */
63               data samp_1(rename=(x6=x6_1 y_bmi=y_bmi_1
63 ! y_bin_gfr=y_bin_gfr_1 bghhsub_s2_nr=w_nr_1))
64                       samp_2(rename=(x6=x6_2 y_bmi=y_bmi_2
64 ! y_bin_gfr=y_bin_gfr_2 bghhsub_s2_nr=w_nr_2))
65                       samp_3(rename=(x6=x6_3 y_bmi=y_bmi_3
65 ! y_bin_gfr=y_bin_gfr_3 bghhsub_s2_nr=w_nr_3));
66                   set samp;
67                   if v_num = 1 then output samp_1;
68                   else if v_num = 2 then output samp_2;
69                   else if v_num = 3 then output samp_3;
70               run;
71   
72               * Sort the 3 datasets;
73               proc sort data = samp_1; by subid; run;
74               proc sort data = samp_2; by subid; run;
75               proc sort data = samp_3; by subid; run;
76   
77                   * merging the 3 new datasets;
78               data samp_wide;
79                   merge samp_1-samp_3;
80                   by subid;
81               run;
82   
83                   * sort the output datasets;
84               proc sort data = samp_wide;
85                    by subid;
86               run;
87   
88                   * obtain the # of missing values by var ;
89               proc means data = samp_wide noprint;
90                    var  x17 x12 x18 y_bmi_1-y_bmi_3 age_strat_new
91                               x6_2-x6_3 y_bin_gfr_1-y_bin_gfr_3
92                               x14 w_nr_1 w_nr_2 w_nr_3;
93                   output out= mi_miss nmiss=;
94               run;
95   
96                   * transpose the values from proc means;
97               proc transpose data = mi_miss(drop=_TYPE_ _FREQ_)
97 ! out=mi_long;
98               run;
99   
100                  * sort the values by # missing;
101              proc sort data = mi_long;
102                      by col1;
103              run;
104  
105              proc sql noprint;
106                      select distinct _name_ into:var separated by ' '
106! from mi_long;
107              quit;
108              %put &var.;
109  
110              data samp_wide;
111                  set samp_wide;
112                  strat_psu = cats(strat_recoded,bgid);
113              run;
114  
115              proc mi data=samp_wide seed=2021 nimpute=&nimpute
115! out=samp_complete;
116                  class strat_psu y_bin_gfr_1 y_bin_gfr_2 y_bin_gfr_3;
117                  fcs reg(x6_2-x6_3 y_bmi_2-y_bmi_3)
117! logistic(y_bin_gfr_2-y_bin_gfr_3);
118                  var &var. strat_psu;
119              run;
120  
121                  /* Transform the imputed datasets from wide format to
121! long */
122              data samp_long;
123                      set samp_complete;
124                      v_num = 1;
125                      x6 = x6_1;
126                      y_bmi = y_bmi_1;
127                      y_bin_gfr = y_bin_gfr_1;
128                      bghhsub_s2_nr = w_nr_1;
129                      output;
130  
131                      v_num = 2;
132                      x6 = x6_2;
133                      y_bmi = y_bmi_2;
134                      y_bin_gfr = y_bin_gfr_2;
135                      bghhsub_s2_nr = w_nr_2;
136                      output;
137  
138                      v_num = 3;
139                      x6 = x6_3;
140                      y_bmi = y_bmi_3;
141                      y_bin_gfr = y_bin_gfr_3;
142                      bghhsub_s2_nr = w_nr_3;
143                      output;
144              run;
145  
146                      * Fit rlogist model from sudaan using corr matrix;
147                  * Looping over the 5 imputed datasets;
148                  %do j = 1 %to &nimpute;
149                      data temp;
150                          set samp_long;
151                          if _imputation_ = &j;
152                      run;
153                  proc sort data = temp;
154                      by strat_recoded bgid hhid subid;
155                  run;
156                      options pagesize=60 linesize=80;
157                      proc rlogist data = temp filetype=sas r=&corr_full
157! semethod=zeger;
158                          %if &corr. = exch %then %do;
159                              nest strat_recoded hhid / psulev=2 ;
160                          %end;
161                          %else %do;
162                              nest strat_recoded hhid;
163                          %end;
164                          weight bghhsub_s2_nr;
165                          model y_bin_gfr = x17 x12 x18 y_bmi
165! age_strat_new x6;
166                          output beta sebeta p_beta t_beta /
166! filename=betas_mi_&corr._&i._&j filetype=sas replace;
167                      run;
168  
169                      data betas_mi_&corr._&i._&j;
170                          merge vars_labels betas_mi_&corr._&i._&j ;
171                          by modelrhs;
172                          _imputation_ = &j;
173                          ClassVal0 = '';
174                          DF = 1;
175                          rename beta = Estimate sebeta = StdErr p_beta =
175! ProbChisq t_beta = WaldChisq;
176                          drop procnum modelno modelrhs;
177                      run;
178                  %end;
179          * merging the imputed datasets;
180          data outparms;
181              set betas_mi_&corr._&i._1 - betas_mi_&corr._&i._&nimpute.;
182          run;
183          * combine estimates;
184          proc mianalyze parms = outparms;
185              modeleffects intercept x17 x12 x18 y_bmi age_strat_new x6;
186              ods output ParameterEstimates = betas_mi_&corr._&i;
187          run;
188          data bs5.&corr._&rr._&i;
189                          SET betas_mi_&corr._&i(RENAME=(UCLMEAN = UPPERCL
189!  LCLMEAN=LOWERCL ));
190          run;
191    %end;
192  %mend impute_sudaan_binary;
193  
194  * miss_ind_mar;
195  %impute_sudaan_binary(start=3, end=100, corr=ind, corr_full=independent,
195!  rr=rr_glm, miss= miss_ind_mar);

