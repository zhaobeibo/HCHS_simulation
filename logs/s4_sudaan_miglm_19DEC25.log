382    %macro impute_sudaan(start=, end=, corr=, corr_full=, miss=);
383      %do i = &start. %to &end.;
384    
385    
386      /*============================*
387       | 1) Split to V1 / V2 / V3   |
388       *============================*/
389      data samp_1 samp_2 samp_3;
390        set sample.samplemiss_&i;
391        where &miss. = 0;   /* keep only non-missing per your scenario flag
391  ! */
392        if      v_num = 1 then output samp_1;
393        else if v_num = 2 then output samp_2;
394        else if v_num = 3 then output samp_3;
395      run;
396    
397      /* Sort all three and build unique ID lists for V2/V3 */
398      proc sort data = samp_1;                           by subid; run;
399      proc sort data = samp_2(keep = subid) out = v2_ids nodupkey; by subid;
399  ! run;
400      proc sort data = samp_3(keep = subid) out = v3_ids nodupkey; by subid;
400  ! run;
401    
402      /*=====================================================*
403       | 2) Add PARTICIPANT_V2 / PARTICIPANT_V3 to the V1   |
404       |    dataset BEFORE missingness + MI                 |
405       *=====================================================*/
406      data samp_1_w_flags;
407        merge samp_1(in = in_v1)
408              v2_ids(in = in_v2)
409              v3_ids(in = in_v3);
410        by subid;
411        if in_v1;
412    
413        /* Raw visit participation flags (before baseline missingness) */
414        PARTICIPANT_V2 = (in_v2 = 1);
415        PARTICIPANT_V3 = (in_v3 = 1);
416    
417        /* Strata indicators: 1/0 flags */
418        length strata1 strata2 strata3 8;
419        strata1 = (strat in (1, 5));
420        strata2 = (strat in (2, 6));
421        strata3 = (strat in (3, 7));
422      run;
423    
424      /* Optional: quick check */
425      proc freq data = samp_1_w_flags;
426        tables PARTICIPANT_V2 PARTICIPANT_V3 / missing;
427      run;
428    
429      /*====================================================*
430       | 3) Inject ~5% MCAR missingness for V1 variables    |
431       |    AND update PARTICIPANT_V2/V3 to "analytic"      |
432       |    flags (participation + non-missing baseline)    |
433       *====================================================*/
434      data samp_1_miss;
435        set samp_1_w_flags;
436    
437        /* Artificial missingness in baseline predictors */
438        array missvars age_base x12 x14;   /* variables to blank */
439        do over missvars;
440          if rand('uniform') < 0.10 then missvars = .;
441        end;
442    
443        /* Re-define PARTICIPANT flags:
444           1 = attended visit AND all baseline variables are non-missing */
445        PARTICIPANT_V2_NOMISS = (PARTICIPANT_V2 = 1 and nmiss(age_base, x12,
445  ! x14) = 0);
446        PARTICIPANT_V3_NOMISS = (PARTICIPANT_V3 = 1 and nmiss(age_base, x12,
446  ! x14) = 0);
447      run;
448    
449      /* Optional: sanity check */
450      proc means data = samp_1_miss n nmiss;
451        var age_base x12 x14;
452      run;
453    
454      /*========================================*
455       | 4) Multiple Imputation on V1 dataset   |
456       |    (baseline-only covariates)          |
457       *========================================*/
458      proc mi data = samp_1_miss seed = 2021 nimpute = 5 out = samp_complete;
459        class strata1 strata2 strata3 x12 x14;
460        var strata1 strata2 strata3 age_base x12 x14 bghhsub_s2;
461        fcs reg(age_base);          /* continuous */
462        fcs logistic(x12 x14);      /* binary/categorical */
463      run;
464    
465      /*===========================*
466       | 5) IPW prediction models  |
467       *===========================*/
468    
469      /* = Visit 2: logistic on analytic PARTICIPANT_V2 flag = */
470      proc logistic data = samp_complete descending noprint;
471        by _Imputation_;
472        class strata1 strata2 strata3 x12 x14 PARTICIPANT_V2_NOMISS;
473        model PARTICIPANT_V2_NOMISS = strata1 strata2 strata3 age_base x12
473  ! x14;
474        output out = pred_v2_imp(keep = _Imputation_ subid xb_v2) xbeta =
474  ! xb_v2;
475      run;
476    
477      proc means data = pred_v2_imp nway noprint;
478        class subid;
479        var xb_v2;
480        output out = pred_v2_bar(drop = _type_ _freq_) mean = xb_v2_bar;
481      run;
482    
483      /* = Visit 3: logistic on analytic PARTICIPANT_V3 flag
484           with baseline + PARTICIPANT_V2 only = */
485      proc logistic data = samp_complete descending noprint;
486        by _Imputation_;
487        class strata1 strata2 strata3 x12 x14 PARTICIPANT_V2
487  ! PARTICIPANT_V3_NOMISS;
488        model PARTICIPANT_V3_NOMISS = strata1 strata2 strata3 age_base x12
488  ! x14 PARTICIPANT_V2;
489        output out = pred_v3_imp(keep = _Imputation_ subid xb_v3) xbeta =
489  ! xb_v3;
490      run;
491    
492      proc means data = pred_v3_imp nway noprint;
493        class subid;
494        var xb_v3;
495        output out = pred_v3_bar(drop = _type_ _freq_) mean = xb_v3_bar;
496      run;
497    
498      /*===========================*
499       | 6) Compute response rates |
500       *===========================*/
501      proc sort data = pred_v2_bar; by subid; run;
502      proc sort data = pred_v3_bar; by subid; run;
503    
504      data samp_ipw;
505        merge pred_v2_bar(rename = (xb_v2_bar = lp_v2))
506              pred_v3_bar(rename = (xb_v3_bar = lp_v3));
507        by subid;
508    
509        /* Predicted response rates (probability of being in analytic set) */
510        if not missing(lp_v2) then RR_V2 = 1 / (1 + exp(-lp_v2));
511        if not missing(lp_v3) then RR_V3 = 1 / (1 + exp(-lp_v3));
512      run;
513    
514    
515    /* --- Starting from samp_ipw already created --- */
516    data samp_ipw_long(keep = subid v_num rr_glm_mask);
517      set samp_ipw;
518    
519      /* Visit 1: everyone contributes */
520      v_num = 1;
521      rr_glm_mask = 1;
522      output;
523    
524      /* Visit 2: only participants with data contribute */
525      v_num = 2;
526      if PARTICIPANT_V2_NOMISS = 1 then
527        rr_glm_mask = RR_V2;
528      else
529        rr_glm_mask = .;
530      output;
531    
532      /* Visit 3: only participants with data contribute */
533      v_num = 3;
534      if PARTICIPANT_V3_NOMISS = 1 then
535        rr_glm_mask = RR_V3;
536      else
537        rr_glm_mask = .;
538      output;
539    run;
540    
541    
542      proc sort data = samp_ipw_long; by subid v_num; run;
543    
544      /* Bring in the base sample restricted by &miss. */
545      data sampmiss;
546        set sample.samplemiss_&i;
547    /*    where &miss. = 0;*/
548      run;
549    
550      proc sort data = sampmiss; by subid v_num; run;
551    
552      /* Merge the rr_glm_mask and compute nonresponse-adjusted weight */
553      data samp;
554        merge sampmiss(in = a)
555              samp_ipw_long(in = b);
556        by subid v_num;
557    
558        if a;
559    
560        /* weight adjusted for nonresponse */
561        bghhsub_s2_nr = bghhsub_s2 / rr_glm_mask;
562    
563          /* Recreate age_strat_new from age_base so missingness propagates
564             consistently with the main model */
565    
566          length age_strat_new 8;
567    
568          if missing(age_base) then do;
569            age_strat_new = .;
570          end;
571          else do;
572            /* same as in import_sample_data.sas */
573            age_strat_new = 1*(age_base >= 45);
574          end;
575    
576      run;
577    
578    
579      /* Sort samp by subid for merging */
580      proc sort data = samp;
581        by subid;
582      run;
583    
584      /* Step 1: Create a dataset with subid in V3 */
585      proc sql;
586         create table valid_subid as
587         select distinct subid
588         from samp
589         where v_num = 3;
590      quit;
591    
592      /* Sort valid_subid by subid for merging */
593      proc sort data = valid_subid;
594        by subid;
595      run;
596    
597      /* Step 2: Merge samp with valid_subid to keep only valid subids */
598      data samp_filtered;
599         merge samp(in=a) valid_subid(in=b);
600         by subid;
601         if b;  /* Only keep records from samp where subid is in valid_subid
601  ! */
602      run;
603    
604      /* Step 3: Create a dataset with the value of bghhsub_s2_nr for v_num =
604  !  3 for each subid */
605      proc sql;
606         create table temp as
607         select subid, bghhsub_s2_nr as bghhsub_s2_v3_nr
608         from samp_filtered
609         where v_num = 3;
610      quit;
611    
612      /* Step 4: Merge the new variable back into the filtered dataset */
613      data samplemiss_&i._;
614         merge samp_filtered temp;
615         by subid;
616      run;
617    
618      /* Order data */
619      proc sort data = samplemiss_&i._;
620        by strat_recoded bgid hhid subid;
621      run;
622    
623    
624      /* Fit regress model from SUDAAN using &corr matrix;
625         In a simulation group meeting it was requested to use hhid as PSUs
625  ! instead of bgid */
626      options pagesize=60 linesize=80;
627      proc regress data = samplemiss_&i._ filetype=sas r=&corr_full
627  ! semethod=zeger;
628        %if  &corr. = exch %then %do;
629          nest strat_recoded hhid / psulev=2 ;
630        %end;
631        %else %do;
632          nest strat_recoded hhid;
633        %end;
634        weight bghhsub_s2_v3_nr;    * use visit-3 adjusted weight;
635        model y_gfr = x17 x12 x18 y_bmi age_strat_new x6;
636        output beta sebeta p_beta t_beta / filename=betas_&corr._&i._
636  ! filetype=sas replace;
637      run;
638    
639      /* Append parameter names to SUDAAN output */
640      data test2.&corr._rr_glm_mask_&i;
641        merge betas_&corr._&i._(rename=(BETA=Estimate SEBETA=Stderr
641  ! P_BETA=ProbZ t_beta=t)) parms;
642        by modelrhs;
643        length parm $ 20;
644        format Estimate Stderr 12.4;
645        drop procnum modelno modelrhs;
646      run;
647    
648      %end;
649    %mend impute_sudaan;
650    
651    * miss_ind_mar;
652    %impute_sudaan(start=1, end=200, corr=ind, corr_full=independent, miss=
652  ! miss_ind_mar);

