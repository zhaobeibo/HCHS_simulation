NOTE: The data set WORK.VARS_LABELS has 7 observations and 2 variables.
NOTE: DATA statement used (Total process time):
      real time           0.01 seconds
      cpu time            0.01 seconds
      

226      ;
227  run;
228  
229  %macro impute_sudaan(start=, end=, corr=, corr_full=, rr=, miss=
229! ,nimpute=5);
230    %do i = &start. %to &end.;
231              data samp;
232                  set sample.samplemiss_&i;
233  
234                  /* weight adjusted for nomresponse */
235                  bghhsub_s2_nr = bghhsub_s2/ &rr.;
236  
237                  where &miss. = 0;
238              run;
239  
240              /* Transform from long to wide */
241                  /* This step is the preparation step for multiple
241! imputation */
242              data samp_1(rename=(x6=x6_1 y_bmi=y_bmi_1 y_gfr=y_gfr_1
242! bghhsub_s2_nr=w_nr_1))
243                      samp_2(rename=(x6=x6_2 y_bmi=y_bmi_2 y_gfr=y_gfr_2
243! bghhsub_s2_nr=w_nr_2))
244                      samp_3(rename=(x6=x6_3 y_bmi=y_bmi_3 y_gfr=y_gfr_3
244! bghhsub_s2_nr=w_nr_3));
245                  set samp;
246                  if v_num = 1 then output samp_1;
247                  else if v_num = 2 then output samp_2;
248                  else if v_num = 3 then output samp_3;
249              run;
250  
251              * Sort the 3 datasets;
252              proc sort data = samp_1; by subid; run;
253              proc sort data = samp_2; by subid; run;
254              proc sort data = samp_3; by subid; run;
255  
256                  * merging the 3 new datasets;
257              data samp_wide;
258                  merge samp_1-samp_3;
259                  by subid;
260              run;
261  
262                  * sort the output datasets;
263              proc sort data = samp_wide;
264                   by subid;
265              run;
266  
267                  * obtain the # of missing values by var ;
268              proc means data = samp_wide noprint;
269                   var  x17 x12 x18 y_bmi_1-y_bmi_3 age_strat_new
270                              x6_2-x6_3 y_gfr_1-y_gfr_3
271                              x14 w_nr_1 w_nr_2 w_nr_3;
272                  output out= mi_miss nmiss=;
273              run;
274  
275                  * transpose the values from proc means;
276              proc transpose data = mi_miss(drop=_TYPE_ _FREQ_)
276! out=mi_long;
277              run;
278  
279                  * sort the values by # missing;
280              proc sort data = mi_long;
281                      by col1;
282              run;
283  
284              proc sql noprint;
285                      select distinct _name_ into:var separated by ' '
285! from mi_long;
286              quit;
287              %put &var.;
288  
289              data samp_wide;
290                  set samp_wide;
291                  strat_psu = cats(strat_recoded,bgid);
292              run;
293  
294              proc mi data=samp_wide seed=2021 nimpute=&nimpute
294! out=samp_complete;
295                  class strat_psu;
296                  fcs reg(x6_2-x6_3 y_gfr_2-y_gfr_3 y_bmi_2-y_bmi_3);
297                  var &var. strat_psu;
298              run;
299  
300                  /* Transform the imputed datasets from wide format to
300! long */
301              data samp_long;
302                      set samp_complete;
303                      v_num = 1;
304                      x6 = x6_1;
305                      y_bmi = y_bmi_1;
306                      y_gfr = y_gfr_1;
307                      bghhsub_s2_nr = w_nr_1;
308                      output;
309  
310                      v_num = 2;
311                      x6 = x6_2;
312                      y_bmi = y_bmi_2;
313                      y_gfr = y_gfr_2;
314                      bghhsub_s2_nr = w_nr_2;
315                      output;
316  
317                      v_num = 3;
318                      x6 = x6_3;
319                      y_bmi = y_bmi_3;
320                      y_gfr = y_gfr_3;
321                      bghhsub_s2_nr = w_nr_3;
322                      output;
323              run;
324  
325                      * Fit regress model from sudaan using corr matrix;
326                  * Looping over the 5 simulated datasets;
327                  %do j = 1 %to &nimpute;
328                      data temp;
329                          set samp_long;
330                          if _imputation_ = &j;
331                      run;
332                  proc sort data = temp;
333                      by strat_recoded bgid hhid subid;
334                  run;
335                      options pagesize=60 linesize=80;
336                      proc regress data = temp filetype=sas r=&corr_full
336! semethod=zeger;
337                          %if &corr. = exch %then %do;
338                              nest strat_recoded hhid / psulev=2 ;
339                          %end;
340                          %else %do;
341                              nest strat_recoded hhid;
342                          %end;
343                          weight bghhsub_s2;
344                          model y_gfr = x17 x12 x18 y_bmi age_strat_new x6
344! ;
345                          output beta sebeta p_beta t_beta /
345! filename=betas_mi_&corr._&i._&j filetype=sas replace;
346                      run;
347  
348                      data betas_mi_&corr._&i._&j;
349                          merge vars_labels betas_mi_&corr._&i._&j ;
350                          by modelrhs;
351                          _imputation_ = &j;
352                          ClassVal0 = '';
353                          DF = 1;
354                          rename beta = Estimate sebeta = StdErr p_beta =
354! ProbChisq t_beta = WaldChisq;
355                          drop procnum modelno modelrhs;
356                      run;
357                  %end;
358          * merging the 10 datasets;
359          data outparms;
360              set betas_mi_&corr._&i._1 - betas_mi_&corr._&i._&nimpute.;
361          run;
362          * combine estimates;
363          proc mianalyze parms = outparms;
364              modeleffects intercept x17 x12 x18 y_bmi age_strat_new x6;
365              ods output ParameterEstimates = betas_mi_&corr._&i;
366          run;
367          data s1.&corr._&rr._&i;
368                          SET betas_mi_&corr._&i(RENAME=(UCLMEAN = UPPERCL
368!  LCLMEAN=LOWERCL ));
369          run;
370    %end;
371  %mend impute_sudaan;
372  
373  * miss_ind_mar;
374  %impute_sudaan(start=501, end=1000, corr=ind, corr_full=independent,
374! rr=rr_glm, miss= miss_ind_mar);

