186       input modelrhs parm $;
187       datalines;

NOTE: The data set WORK.PARMS has 7 observations and 2 variables.
NOTE: DATA statement used (Total process time):
      real time           0.03 seconds
      cpu time            0.00 seconds
      

195   ;
196   run;
197   
198   %macro impute_sudaan(start=, end=, corr=, corr_full=, miss=);
199     %do i = &start. %to &end.;
200   
201       data samp;
202           set sample.samplemiss_&i;
203   
204           /* weight adjusted for nomresponse */
205           bghhsub_s2_nr = bghhsub_s2/ (rr_glm*rr_nradj);
206   
207           where &miss. = 0;
208       run;
209   
210       /* Sort samp by subid for merging */
211       proc sort data = samp;
212           by subid;
213       run;
214   
215       /* Step 1: Create a dataset with subid in V3 */
216       proc sql;
217          create table valid_subid as
218          select distinct subid
219          from samp
220          where v_num = 3;
221       quit;
222   
223       /* Sort valid_subid by subid for merging */
224       proc sort data = valid_subid;
225           by subid;
226       run;
227   
228       /* Step 2: Merge samp with valid_subid to keep only valid subids */
229       data samp_filtered;
230          merge samp(in=a) valid_subid(in=b);
231          by subid;
232          if b;  /* Only keep records from samp where subid is in valid_subid
232 !  */
233       run;
234   
235       /* Step 3: Create a dataset with the value of bghhsub_s2_nr for v_num
235 ! = 3 for each subid */
236       proc sql;
237          create table temp as
238          select subid, bghhsub_s2_nr as bghhsub_s2_v3_nr
239          from samp_filtered
240          where v_num = 3;
241       quit;
242   
243       /* Step 4: Merge the new variable back into the filtered dataset */
244       data samplemiss_&i._;
245          merge samp_filtered temp;
246          by subid;
247       run;
248   
249       /* Order data */
250       proc sort data = samplemiss_&i._;
251           by strat_recoded bgid hhid subid;
252       run;
253   
254   
255       * Fit regress model from sudaan using &corr matrix;
256           * In a simulation group meeting it was requested to use hhid as
256 ! PSUs instead of bgid;
257       options pagesize=60 linesize=80;
258       proc regress data = samplemiss_&i._ filetype=sas r=&corr_full
258 ! semethod=zeger;
259           %if  &corr. = exch %then %do;
260               nest strat_recoded hhid / psulev=2 ;
261           %end;
262           %else %do;
263               nest strat_recoded hhid;
264           %end;
265           weight bghhsub_s2_v3_nr;    *use visit-3 adjusted weight;
266           model y_gfr = x17 x12 x18 y_bmi age_strat_new x6;
267           output beta sebeta p_beta t_beta / filename=betas_&corr._&i._
267 ! filetype=sas replace;
268       run;
269   
270       * Append parameter names to sudaan output;
271       data test1.&corr._double_rr_&i;
272           merge betas_&corr._&i._(rename=(BETA=Estimate SEBETA=Stderr
272 ! P_BETA=ProbZ t_beta=t)) parms;
273           by modelrhs;
274           length parm $ 20;
275           format Estimate Stderr 12.4;
276           drop procnum modelno modelrhs;
277       run;
278   
279   
280     %end;
281   %mend impute_sudaan;
282   
283   * miss_ind_mar;
284   %impute_sudaan(start=1, end=100, corr=ind, corr_full=independent, miss=
284 ! miss_ind_mar);

