NOTE: PROCEDURE PRINTTO used (Total process time):
      real time           0.02 seconds
      cpu time            0.00 seconds
      

513    
514    
515    /*------------------------------------------------------------*
516     | PARMS mapping (NO Level1)                                   |
517     | - Use ONLY Parameter/parm mapping                           |
518     | - age_strat_new: we will keep the row with non-missing Z     |
519     *------------------------------------------------------------*/
520    data parms;
521      length parm $20 Parameter $32;
522      input modelrhs parm $ Parameter $;
523      datalines;

NOTE: The data set WORK.PARMS has 7 observations and 3 variables.
NOTE: DATA statement used (Total process time):
      real time           0.02 seconds
      cpu time            0.01 seconds
      

531    ;
532    run;
533    
534    %macro impute_genmod(start=, end=, corr = );
535    
536    
537      %do i = &start %to &end;
538    
539        /*============================*
540         | 0) Read sample + recode    |
541         *============================*/
542        data samplemiss_&i;
543           set sampmiss.samplemiss_10pct_&i;
544    /*      set sampmiss.samplemiss_50pct_&i._;*/
545    
546          where miss_ind_mar = 0; /* remove missing visits */
547    
548          if strat in (1,5) then strat_recoded = 1;
549          else if strat in (2,6) then strat_recoded = 2;
550          else if strat in (3,7) then strat_recoded = 3;
551          else if strat in (4,8) then strat_recoded = 4;
552        run;
553    
554        proc sort data=samplemiss_&i;
555          by strat_recoded bgid hhid subid;
556        run;
557    
558        ods exclude all;
559        ods output GEEEmpPEst = betas_&corr._&i;   /* robust (empirical) PE table */
560        proc genmod data=samplemiss_&i ;
561          class hhid age_strat_new(ref = '0');
562          weight bghhsub_s2_nr;  * use visit-specific adjusted weight;
563          model y_gfr = x17 x12 x18 y_bmi age_strat_new x6
564            / dist=normal link=identity;
565          repeated subject=hhid / type=ind ;
566        run;
567        ods output close;
568        ods exclude none;
569    
570    
571    
572    /*============================================================*
573     | 2) Standardize GENMOD output to match downstream merge       |
574     |    - Ignore Level1 entirely                                  |
575     |    - Keep only rows with non-missing Z (drops ref rows)       |
576     |    - For age_strat_new this keeps the estimable row (Z!=.)    |
577     *============================================================*/
578    
579    data betas_&corr._&i._prep;
580      set betas_&corr._&i;
581    
582      length Parameter $32;
583    
584      /* Map GENMOD name -> Parameter used for merge */
585      Parameter = strip(Parm);
586    
587      /* Keep only parameters we care about */
588      if upcase(Parameter) not in ("INTERCEPT","X17","X12","X18","Y_BMI","AGE_STRAT_NEW","X6") then
588  !  delete;
589    
590      /* Keep only estimable rows (reference rows have Z = .) */
591      if missing(Z) then delete;
592    
593      /* Create t-stat placeholder (combine code expects 't') */
594      t = Z;
595    
596      keep Parameter Estimate Stderr ProbZ t;
597    run;
598    
599    /* Sort for merge */
600    proc sort data=betas_&corr._&i._prep; by Parameter; run;
601    proc sort data=parms;                 by Parameter; run;
602    
603    /* Final output dataset matches your combine macro expectations */
604    data test2.&corr._rr_glm_mask_&i;
605      merge betas_&corr._&i._prep(in=a)
606            parms(in=b);
607      by Parameter;
608      if a;
609    
610      format Estimate Stderr 12.4;
611      keep modelrhs parm Estimate Stderr ProbZ t;
612    run;
613    
614    
615      %end;
616    
617    %mend impute_genmod;
618    
619    /* miss_ind_mar */
620    %impute_genmod(start=1, end=500, corr = ind);
