277  ***************************************************************************
277! ******************************
278  
279          PROGRAM NAME: regress_sudaan.sas
280  
281          PROGRAMMER: AQA
282  
283          DESCRIPTION:
284  
285          VERSION CONTROL:
286                          - 20FEB25: Initialize the code
287                          - 30may25: Uncomment the miss_ind_mar = 0 so we
287! obtain the complete data case
288  
289  ***************************************************************************
289! ******************************;
290  
291  * Run sudaan models for the 100 files;
292  %macro regress_sudaan(start=1, end=100, corr=, corr_full=);
293    %do i = &start %to &end;
294  
295      * use only available data;
296      proc sql;
297          create table samplemiss_&i._ as
298          select *
299          from sample.samplemiss_&i.
300          where miss_ind_mar = 0; /* Select only records with no missingness
300! */
301      quit;
302  
303      * order data;
304      proc sort data = samplemiss_&i._;
305          by strat_recoded bgid hhid subid;
306      run;
307  
308      * Fit regress model from sudaan using &corr matrix;
309          * In a simulation group meeting it was requested to use hhid as
309! PSUs instead of bgid;
310      options pagesize=60 linesize=80;
311      proc regress data = samplemiss_&i._ filetype=sas r=&corr_full
311! semethod=zeger;
312          %if  &corr. = exch %then %do;
313              nest strat_recoded hhid / psulev=2 ;
314          %end;
315          %else %do;
316              nest strat_recoded hhid;
317          %end;
318          weight bghhsub_s2;
319          model y_gfr = x17 x12 x18 y_bmi age_strat_new x6;
320          output beta sebeta p_beta t_beta / filename=betas_&corr._&i._
320! filetype=sas replace;
321      run;
322  
323      * Append parameter names to sudaan output;
324      data dt_b_s2.betas_&corr._&i;
325          merge betas_&corr._&i._(rename=(BETA=Estimate SEBETA=Stderr
325! P_BETA=ProbZ t_beta=t)) parms;
326          by modelrhs;
327          length parm $ 20;
328          drop procnum modelno modelrhs;
329      run;
330  
331    %end;
332  %mend regress_sudaan;
333  
334  * Create dataset with parms labels;
335  data parms;
336      length Parm $ 15;
337      input modelrhs parm $;
338      datalines;

NOTE: The data set WORK.PARMS has 7 observations and 2 variables.
NOTE: DATA statement used (Total process time):
      real time           0.01 seconds
      cpu time            0.00 seconds
      

346  ;
347  run;
348  
349  /* Execute the macro for exchangeable correlation matrix */
350  %regress_sudaan(corr=ind, corr_full=independent);
