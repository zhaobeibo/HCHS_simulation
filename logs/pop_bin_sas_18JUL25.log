877   
878   * Macro that fit a SAS GENMOD model with a binary logistic response;
879   %macro pop_sas(corr=);
880       options pagesize=60 linesize=80;
881   
882       title "[SAS GENMOD] &corr. correlation structure - Binary Model";
883   
884       proc genmod data=pop descending;
885           class subid;
886           model y_bin_gfr = x17 x12 x18 y_bmi age_strat_new x6 / dist=binomial link=logit;
887           repeated subject=subid / corr=&corr.;
888           ods output GEEEmpPEst=betas_&corr._temp;
889       run;
890   
891       * Process and format the output to match SUDAAN format;
892       data dt_betas.betas_pop_bin_sas_&corr.;
893           set betas_&corr._temp;
894           length Parm $ 20;
895   
896           * Map parameter names;
897           if Parm = 'Intercept' then Parm = 'Intercept';
898           else if Parm = 'x17' then Parm = 'x17';
899           else if Parm = 'x12' then Parm = 'x12';
900           else if Parm = 'x18' then Parm = 'x18';
901           else if Parm = 'y_bmi' then Parm = 'y_bmi';
902           else if Parm = 'age_strat_new' then Parm = 'age_strat_new';
903           else if Parm = 'x6' then Parm = 'x6';
904   
905           * Rename variables to match SUDAAN output format;
906           Estimate = Estimate;
907           Stderr = StdErr;
908           ProbZ = ProbZ;
909           t = ZValue;
910   
911           keep Parm Estimate Stderr ProbZ t;
912       run;
913   
914       * Clean up temporary dataset;
915       proc datasets library=work nolist;
916           delete betas_&corr._temp;
917       quit;
918   %mend pop_sas;
