651    
652    
653    /*------------------------------------------------------------*
654     | PARMS mapping (NO Level1)                                   |
655     | - Use ONLY Parameter/parm mapping                           |
656     | - age_strat_new: we will keep the row with non-missing Z     |
657     *------------------------------------------------------------*/
658    data parms;
659      length parm $20 Parameter $32;
660      input modelrhs parm $ Parameter $;
661      datalines;

NOTE: The data set WORK.PARMS has 7 observations and 3 variables.
NOTE: DATA statement used (Total process time):
      real time           0.01 seconds
      cpu time            0.00 seconds
      

669    ;
670    run;
671    
672    %macro impute_genmod(start=, end=, corr = );
673    
674    
675      %do i = &start %to &end;
676    
677        /*============================*
678         | 0) Read sample + recode    |
679         *============================*/
680        data samplemiss_&i;
681          /* set sampmiss.samplemiss_10pct_&i; */
682          set sampmiss.samplemiss_50pct_&i._;
683    
684          if strat in (1,5) then strat_recoded = 1;
685          else if strat in (2,6) then strat_recoded = 2;
686          else if strat in (3,7) then strat_recoded = 3;
687          else if strat in (4,8) then strat_recoded = 4;
688        run;
689    
690        proc sort data=samplemiss_&i;
691          by strat_recoded bgid hhid subid;
692        run;
693    
694    
695        ods output GEEEmpPEst = betas_&corr._&i;   /* robust (empirical) PE table */
696        proc genmod data=samplemiss_&i ;
697          class hhid age_strat_new(ref = '0');
698          weight bghhsub_s2_v3_nr;  * use visit-3 adjusted weight;
699          model y_gfr = x17 x12 x18 y_bmi age_strat_new x6
700            / dist=normal link=identity;
701          repeated subject=hhid / type=ind ;
702        run;
703        ods output close;
704    
705    
706    
707    /*============================================================*
708     | 2) Standardize GENMOD output to match downstream merge       |
709     |    - Ignore Level1 entirely                                  |
710     |    - Keep only rows with non-missing Z (drops ref rows)       |
711     |    - For age_strat_new this keeps the estimable row (Z!=.)    |
712     *============================================================*/
713    
714    data betas_&corr._&i._prep;
715      set betas_&corr._&i;
716    
717      length Parameter $32;
718    
719      /* Map GENMOD name -> Parameter used for merge */
720      Parameter = strip(Parm);
721    
722      /* Keep only parameters we care about */
723      if upcase(Parameter) not in ("INTERCEPT","X17","X12","X18","Y_BMI","AGE_STRAT_NEW","X6") then
723  !  delete;
724    
725      /* Keep only estimable rows (reference rows have Z = .) */
726      if missing(Z) then delete;
727    
728      /* Create t-stat placeholder (combine code expects 't') */
729      t = Z;
730    
731      keep Parameter Estimate Stderr ProbZ t;
732    run;
733    
734    /* Sort for merge */
735    proc sort data=betas_&corr._&i._prep; by Parameter; run;
736    proc sort data=parms;                 by Parameter; run;
737    
738    /* Final output dataset matches your combine macro expectations */
739    data test2.&corr._rr_glm_mask_&i;
740      merge betas_&corr._&i._prep(in=a)
741            parms(in=b);
742      by Parameter;
743      if a;
744    
745      format Estimate Stderr 12.4;
746      keep modelrhs parm Estimate Stderr ProbZ t;
747    run;
748    
749    
750      %end;
751    
752    %mend impute_genmod;
753    
754    /* miss_ind_mar */
755    %impute_genmod(start=1, end=500, corr = ind);
