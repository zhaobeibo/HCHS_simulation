406     ************************************************************************
406   ! *********************************
407     
408             PROGRAM NAME: import_sample_data.sas
409     
410             PROGRAMMER: AQA
411     
412             DESCRIPTION:  Convert the csv files in sas files
413     
414             VERSION CONTROL:
415                             - 20feb25: Initialize the code
416                             - 26may25: Include the bghhsub_s2_nr adjusted
416   ! byr RR_glm and RR_NRadj
417                                        If the dataset already exists, it
417   ! only update the file
418     
419     
420     ************************************************************************
420   ! *********************************;
421     
422     * Macro that import 1 to n csv files and convert them in sas dataset;
423     %macro process_files(start=1, end=);
424       %do i = &start. %to &end.;
425         /* Define paths and names dynamically */
426         %let csv_file = &homepath./data/raw/sample/samplemiss_&i..csv;
427         %let out_table = sample.samplemiss_&i;
428     
429         %if %sysfunc(exist(sample.samplemiss_&i)) %then %do;
430             data sample.samplemiss_&i;
431                 set sample.samplemiss_&i;
432     
433                 bghhsub_s2_nr_glm = bghhsub_s2/RR_glm;
434                 bghhsub_s2_nr_NRadj = bghhsub_s2/RR_NRadj;
435             run;
436         %end;
437         %else %do;
438             proc import
439                 datafile="&csv_file"
440                 out=&out_table.
441                 dbms=csv
442                 replace;
443                 getnames=yes;
444                 guessingrows=100;
445             run;
446     
447             * Derive new variables ;
448             data sample.samplemiss_&i;
449                 set sample.samplemiss_&i;
450     
451                 age_strat_new = 1*(age_base >= 45);
452                 if strat in (1,5) then strat_recoded = 1;
453                 else if strat in (2,6) then strat_recoded = 2;
454                 else if strat in (3,7) then strat_recoded = 3;
455                 else if strat in (4,8) then strat_recoded = 4;
456     
457                 bghhsub_s2_nr_glm = bghhsub_s2/RR_glm;
458                 bghhsub_s2_nr_NRadj = bghhsub_s2/RR_NRadj;
459             run;
460     
461             * sort by strat_recoded;
462              proc sort data = sample.samplemiss_&i; by strat_recoded; run;
463          %end;
464     
465       %end;
466     %mend;
467     
468     /* Execute the macro */
469     %process_files(start=501,end=1000);

