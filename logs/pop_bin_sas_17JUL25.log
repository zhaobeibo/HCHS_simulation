139  
140  * Macro that fit a SAS GENMOD model with a binary logistic response;
141  %macro pop_sas(corr=);
142      options pagesize=60 linesize=80;
143  
144      title "[SAS GENMOD] &corr. correlation structure - Binary Model";
145  
146      proc genmod data=pop;
147          class subid;
148          model y_bin_gfr = x17 x12 x18 y_bmi age_strat_new x6 / dist=binomial link=logit;
149          repeated subject=subid / corr=&corr.;
150          ods output GEEEmpPEst=betas_&corr._temp;
151      run;
152  
153      * Process and format the output to match SUDAAN format;
154      data dt_betas.betas_pop_bin_sas_&corr.;
155          set betas_&corr._temp;
156          length Parm $ 20;
157  
158          * Map parameter names;
159          if Parm = 'Intercept' then Parm = 'Intercept';
160          else if Parm = 'x17' then Parm = 'x17';
161          else if Parm = 'x12' then Parm = 'x12';
162          else if Parm = 'x18' then Parm = 'x18';
163          else if Parm = 'y_bmi' then Parm = 'y_bmi';
164          else if Parm = 'age_strat_new' then Parm = 'age_strat_new';
165          else if Parm = 'x6' then Parm = 'x6';
166  
167          * Rename variables to match SUDAAN output format;
168          Estimate = Estimate;
169          Stderr = StdErr;
170          ProbZ = ProbZ;
171          t = ZValue;
172  
173          keep Parm Estimate Stderr ProbZ t;
174      run;
175  
176      * Clean up temporary dataset;
177      proc datasets library=work nolist;
178          delete betas_&corr._temp;
179      quit;
180  %mend pop_sas;
