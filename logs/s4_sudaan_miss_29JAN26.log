538   
539   %macro impute_sudaan(start=, end=, corr=, corr_full=, miss=);
540     %do i = &start. %to &end.;
541   
542     /*============================*
543      | 1) Split to V1 / V2 / V3   |
544      *============================*/
545     data samplemiss_&i._;
546   /*    set  sampmiss.samplemiss_10pct_&i._;*/
547         set  sampmiss.samplemiss_50pct_&i._;
548   
549                   if strat in (1,5) then strat_recoded = 1;
550               else if strat in (2,6) then strat_recoded = 2;
551               else if strat in (3,7) then strat_recoded = 3;
552               else if strat in (4,8) then strat_recoded = 4;
553   
554     run;
555   
556     /* Order data */
557     proc sort data = samplemiss_&i._;
558       by strat_recoded bgid hhid subid;
559     run;
560   
561   
562     /* Fit regress model from SUDAAN using &corr matrix;
563        In a simulation group meeting it was requested to use hhid as PSUs
563 ! instead of bgid */
564     options pagesize=60 linesize=80;
565     proc regress data = samplemiss_&i._ filetype=sas r=&corr_full
565 ! semethod=zeger;
566       %if  &corr. = exch %then %do;
567         nest strat_recoded hhid / psulev=2 ;
568       %end;
569       %else %do;
570         nest strat_recoded hhid;
571       %end;
572       weight bghhsub_s2_v3_nr;    * use visit-3 adjusted weight;
573       subpopn PARTICIPANT_V3_NOMISS = 1;
574       model y_gfr = x17 x12 x18 y_bmi age_strat_new x6;
575       output beta sebeta p_beta t_beta / filename=betas_&corr._&i._
575 ! filetype=sas replace;
576     run;
577   
578     /* Append parameter names to SUDAAN output */
579     data test2.&corr._rr_glm_mask_&i;
580       merge betas_&corr._&i._(rename=(BETA=Estimate SEBETA=Stderr
580 ! P_BETA=ProbZ t_beta=t)) parms;
581       by modelrhs;
582       length parm $ 20;
583       format Estimate Stderr 12.4;
584       drop procnum modelno modelrhs;
585     run;
586   
587     %end;
588   %mend impute_sudaan;
589   
590   * miss_ind_mar;
591   %impute_sudaan(start=1, end=200, corr=ind, corr_full=independent, miss=
591 ! miss_ind_mar);
