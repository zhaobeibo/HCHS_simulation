276  ***************************************************************************
276! ******************************
277  
278          PROGRAM NAME: import_sample_data.sas
279  
280          PROGRAMMER: AQA
281  
282          DESCRIPTION:  Convert the csv files in sas files
283  
284          VERSION CONTROL:
285                          - 20feb25: Initialize the code
286                          - 26may25: Include the bghhsub_s2_nr adjusted byr
286! RR_glm and RR_NRadj
287                                     If the dataset already exists, it only
287! update the file
288  
289  
290  ***************************************************************************
290! ******************************;
291  
292  * Macro that import 1 to n csv files and convert them in sas dataset;
293  %macro process_files(start=1, end=);
294    %do i = &start. %to &end.;
295      /* Define paths and names dynamically */
296      %let csv_file = &homepath./data/raw/sample/samplemiss_&i..csv;
297      %let out_table = sample.samplemiss_&i;
298  
299      %if %sysfunc(exist(sample.samplemiss_&i)) %then %do;
300          data sample.samplemiss_&i;
301              set sample.samplemiss_&i;
302  
303              bghhsub_s2_nr_glm = bghhsub_s2/RR_glm;
304              bghhsub_s2_nr_NRadj = bghhsub_s2/RR_NRadj;
305          run;
306      %end;
307      %else %do;
308          proc import
309              datafile="&csv_file"
310              out=&out_table.
311              dbms=csv
312              replace;
313              getnames=yes;
314              guessingrows=100;
315          run;
316  
317          * Derive new variables ;
318          data sample.samplemiss_&i;
319              set sample.samplemiss_&i;
320  
321              age_strat_new = 1*(age_base >= 45);
322              if strat in (1,5) then strat_recoded = 1;
323              else if strat in (2,6) then strat_recoded = 2;
324              else if strat in (3,7) then strat_recoded = 3;
325              else if strat in (4,8) then strat_recoded = 4;
326  
327              bghhsub_s2_nr_glm = bghhsub_s2/RR_glm;
328              bghhsub_s2_nr_NRadj = bghhsub_s2/RR_NRadj;
329          run;
330  
331          * sort by strat_recoded;
332           proc sort data = sample.samplemiss_&i; by strat_recoded; run;
333       %end;
334  
335    %end;
336  %mend;
337  
338  /* Execute the macro */
339  %process_files(start=1,end=500);

