NOTE: PROCEDURE PRINTTO used (Total process time):
      real time           0.03 seconds
      cpu time            0.03 seconds
      

964    
965    
966    * Run sudaan models for the 100 files;
967    %macro regress_sudaan(start=, end=, corr=, corr_full=);
968      %do i = &start %to &end;
969    
970        * use only available data;
971        proc sql;
972            create table samplemiss_&i._ as
973            select *
974            from sample.samplemiss_&i.
975            where miss_ind_mar = 0; /* Select only records with no
975  ! missingness */
976        quit;
977    
978        * order data;
979        proc sort data = samplemiss_&i._;
980            by strat_recoded bgid hhid subid;
981        run;
982    
983        * Fit regress model from sudaan using &corr matrix;
984            * In a simulation group meeting it was requested to use hhid as
984  ! PSUs instead of bgid;
985        options pagesize=60 linesize=80;
986        proc rlogist data = samplemiss_&i._ filetype=sas r=&corr_full
986  ! semethod=zeger;
987            %if  &corr. = exch %then %do;
988                nest strat_recoded hhid / psulev=2 ;
989            %end;
990            %else %do;
991                nest strat_recoded hhid;
992            %end;
993            weight bghhsub_s2;
994            model y_bin_gfr = x17 x12 x18 y_bmi age_strat_new x6;
995            output beta sebeta p_beta t_beta / filename=betas_&corr._&i._
995  ! filetype=sas replace;
996        run;
997    
998        * Append parameter names to sudaan output;
999        data bs2.&corr._&i;
1000           merge betas_&corr._&i._(rename=(BETA=Estimate SEBETA=Stderr
1000 ! P_BETA=ProbZ t_beta=t)) parms;
1001           by modelrhs;
1002           length parm $ 20;
1003           format Estimate Stderr 12.4;
1004           drop procnum modelno modelrhs;
1005       run;
1006   
1007     %end;
1008   %mend regress_sudaan;
1009   
1010   * Create dataset with parms labels;
1011   data parms;
1012       length Parm $ 15;
1013       input modelrhs parm $;
1014       datalines;

NOTE: The data set WORK.PARMS has 7 observations and 2 variables.
NOTE: DATA statement used (Total process time):
      real time           0.00 seconds
      cpu time            0.00 seconds
      

1022   ;
1023   run;
1024   
