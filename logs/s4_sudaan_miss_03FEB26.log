356        length Parm $ 15;
357        input modelrhs parm $;
358        datalines;

NOTE: The data set WORK.PARMS has 7 observations and 2 variables.
NOTE: DATA statement used (Total process time):
      real time           0.01 seconds
      cpu time            0.01 seconds
      

366    ;
367    run;
368    
369    %macro impute_sudaan(start=, end=, corr=, corr_full=, miss=);
370      %do i = &start. %to &end.;
371    
372      /*============================*
373       | 1) Split to V1 / V2 / V3   |
374       *============================*/
375      data samplemiss_&i._;
376    /*    set  sampmiss.samplemiss_10pct_&i._;*/
377          set  sampmiss.samplemiss_50pct_&i._;
378    
379              where miss_ind_mar = 0; /* remove missing visits */
380    
381                    if strat in (1,5) then strat_recoded = 1;
382                else if strat in (2,6) then strat_recoded = 2;
383                else if strat in (3,7) then strat_recoded = 3;
384                else if strat in (4,8) then strat_recoded = 4;
385    
386      run;
387    
388      /* Order data */
389      proc sort data = samplemiss_&i._;
390        by strat_recoded bgid hhid subid;
391      run;
392    
393    
394      /* Fit regress model from SUDAAN using &corr matrix;
395         In a simulation group meeting it was requested to use hhid as PSUs instead of bgid */
396      options pagesize=60 linesize=80;
397      proc regress data = samplemiss_&i._ filetype=sas r=&corr_full semethod=zeger;
398        %if  &corr. = exch %then %do;
399          nest strat_recoded hhid / psulev=2 ;
400        %end;
401        %else %do;
402          nest strat_recoded hhid;
403        %end;
404        weight bghhsub_s2_v3_nr;    * use visit-3 adjusted weight;
405        subpopn PARTICIPANT_V3_NOMISS = 1;
406        model y_gfr = x17 x12 x18 y_bmi age_strat_new x6;
407        output beta sebeta p_beta t_beta / filename=betas_&corr._&i._ filetype=sas replace;
408      run;
409    
410      /* Append parameter names to SUDAAN output */
411      data test2.&corr._rr_glm_mask_&i;
412        merge betas_&corr._&i._(rename=(BETA=Estimate SEBETA=Stderr P_BETA=ProbZ t_beta=t)) parms;
413        by modelrhs;
414        length parm $ 20;
415        format Estimate Stderr 12.4;
416        drop procnum modelno modelrhs;
417      run;
418    
419      %end;
420    %mend impute_sudaan;
421    
422    * miss_ind_mar;
423    %impute_sudaan(start=1, end=500, corr=ind, corr_full=independent, miss= miss_ind_mar);
