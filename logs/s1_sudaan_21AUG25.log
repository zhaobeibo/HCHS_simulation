195! rr=rr_glm, miss= miss_ind_mar);*/
196  /*%impute_sudaan(start=501, end=1000, corr=ind, corr_full=independent,
196! rr=RR_NRadj, miss= miss_ind_mar);*/
197  
198  %impute_sudaan(start=501, end=1000, corr=exch, corr_full=exchangeable,
198! rr=rr_glm, miss= miss_ind_mar);

