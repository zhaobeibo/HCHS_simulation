NOTE: PROCEDURE PRINTTO used (Total process time):
      real time           0.01 seconds
      cpu time            0.00 seconds
      

392  
393  ***************************************************************************
393! ******************************
394  
395          PROGRAM NAME: combine_mi_sudaan.sas
396          PROGRAMMER: Beibo Zhao (updated from AQA)
397          DESCRIPTION: Combine MI results and calculate performance metrics
397! for HCHS V3 simulation
398          VERSION CONTROL:
399                          - 24APR25: Initialize the code (AQA)
400                          - Aug2025: Updated for consistency with R
400! simulation framework (BZ)
401  ***************************************************************************
401! ******************************;
402  
403  %macro combine_mi_betas(start=1, end=100, corr=, rr=, miss_type=);
404  
405      /* Determine correlation structure name for file paths */
406      %let corr_name = %sysfunc(lowcase(&corr.));
407  
408      /* Determine response rate method abbreviation */
409      %let rr_abbrev = &rr.;
410      %if &rr. = rr_glm %then %let rr_abbrev = glm;
411      %else %if &rr. = RR_NRadj %then %let rr_abbrev = NRadj;
412      %else %if &rr. = rr_glm_strat %then %let rr_abbrev = glm_strat;
413      %else %if &rr. = RR_glm_agestrat_strat %then %let rr_abbrev =
413! glm_agestrat_strat;
414      %else %if &rr. = RR_NRadj_strat %then %let rr_abbrev = NRadj_strat;
415  
416      /* Create suffix for output identification */
417      %let suffix = &corr_name._&rr_abbrev._&miss_type.;
418  
419      /* Merge files containing beta estimates using sample data */
420      data merge_betas;
421          set dt_b_s1.&corr_name._&rr._&start. -
421! dt_b_s1.&corr_name._&rr._&end.;
422          /* Standardize parameter names to match population estimates */
423          if parm = 'intercept' then parm = 'Intercept';
424          /* Add identifier for tracking */
425          suffix = "&suffix.";
426          corr_structure = "&corr.";
427          rr_method = "&rr.";
428          miss_mechanism = "&miss_type.";
429      run;
430  
431      /* Append the true values from population estimates */
432      proc sql;
433          create table betas_samp_pop as
434          select a.*, b.estimate as true_value
435          from merge_betas as a
436          right join
437          dt_betas.betas_pop_&corr_name. as b
438          on upcase(a.parm) = upcase(b.parm);
439      quit;
440  
441      /* Compute 95% confidence intervals */
442      data betas_samp_pop;
443          set betas_samp_pop;
444          /* Calculate confidence intervals */
445          uppercl = Estimate + 1.96 * Stderr;
446          lowercl = Estimate - 1.96 * Stderr;
447  
448          /* Ensure we have valid true values */
449          if missing(true_value) then delete;
450      run;
451  
452      /* Calculate performance metrics */
453      data betas_samp_pop_metrics;
454          set betas_samp_pop;
455  
456          /* Coverage indicator (1 if true value is within CI) */
457          coverage_ind = (uppercl >= true_value & lowercl <= true_value);
458  
459          /* Bias calculations */
460          bias = estimate - true_value;
461          rel_bias = bias / true_value;
462  
463          /* Hypothesis test (reject H0: parameter = 0) */
464          reject_h0 = (abs(estimate/stderr) > 1.96);
465  
466          /* Additional metrics for debugging */
467          abs_bias = abs(bias);
468          squared_error = bias**2;
469      run;
470  
471      /* Calculate summary statistics across all simulations */
472      proc means data=betas_samp_pop_metrics noprint nway;
473          class parm;
474          var true_value estimate bias rel_bias stderr coverage_ind reject_h0
474!  abs_bias squared_error;
475          output out=summary_stats
476                 mean(true_value estimate bias rel_bias stderr coverage_ind
476! reject_h0)=
477                      true_value estimate empirical_bias relative_bias
477! estimated_se coverage p_reject_h0
478                 std(estimate)=empirical_se
479                 mean(abs_bias)=mean_abs_bias
480                 mean(squared_error)=mse
481                 n=n_sims;
482      run;
483  
484      /* Calculate additional derived metrics */
485      data final_output;
486          set summary_stats;
487  
488          /* Relative SE difference */
489          rel_se_diff = estimated_se/empirical_se - 1;
490  
491          /* RMSE */
492          rmse = sqrt(mse);
493  
494          /* Add identifiers */
495          suffix = "&suffix.";
496          corr_structure = "&corr.";
497          rr_method = "&rr.";
498          miss_mechanism = "&miss_type.";
499  
500          /* Rename to match expected output format */
501          rename parm = Parameter
502                 true_value = True_Value
503                 estimate = Estimate
504                 empirical_bias = Empirical_Bias
505                 relative_bias = Relative_Bias
506                 empirical_se = Empirical_SE
507                 estimated_se = Estimated_SE
508                 rel_se_diff = Relative_SE_difference
509                 coverage = Coverage
510                 p_reject_h0 = P_reject_H0;
511  
512          /* Clean up intermediate variables */
513          drop _TYPE_ _FREQ_ abs_bias squared_error mse;
514      run;
515  
516      /* Save results to permanent dataset */
517      data results.mi_performance_&suffix.;
518          set final_output;
519      run;
520  
521      /* Generate formatted report */
522      ods rtf
522! file="&homepath./output/reports/mi_performance_&suffix._&sysdate..rtf"
523              style=journal bodytitle;
524  
525          title1 "Multiple Imputation Performance Results";
526          title2 "Correlation: &corr. | Response Rate Method: &rr. | Missing
526! Mechanism: &miss_type.";
527          title3 "Simulations &start. through &end.";
528  
529          proc print data=final_output noobs label;
530              var Parameter True_Value Estimate Empirical_Bias Relative_Bias
531                  Empirical_SE Estimated_SE Relative_SE_difference Coverage
531! P_reject_H0 n_sims;
532  
533              label Parameter='Parameter'
534                    True_Value='True Value'
535                    Estimate='Mean Estimate'
536                    Empirical_Bias='Empirical Bias'
537                    Relative_Bias='Relative Bias (%)'
538                    Empirical_SE='Empirical SE'
539                    Estimated_SE='Mean Estimated SE'
540                    Relative_SE_difference='Relative SE Difference (%)'
541                    Coverage='Coverage Probability'
542                    P_reject_H0='Power (P(reject H0))'
543                    n_sims='N Simulations';
544  
545              format Relative_Bias Relative_SE_difference percent8.1
546                     Coverage P_reject_H0 8.3
547                     Empirical_Bias Estimate 8.4
548                     True_Value Empirical_SE Estimated_SE 8.3;
549          run;
550  
551          /* Additional summary for coverage issues */
552          title4 "Coverage Issues Summary";
553          proc print data=final_output noobs;
554              where Coverage < 0.92 or Coverage > 0.97;
555              var Parameter Coverage True_Value Empirical_SE Estimated_SE;
556              format Coverage 8.3;
557          run;
558  
559      ods rtf close;
560  
561  %mend combine_mi_betas;
562  
563  /* Execute analysis for all combinations consistent with R simulation */
564  
565  /* Independent correlation structure */
566  %combine_mi_betas(corr=independent, rr=rr_glm, miss_type=mar);
