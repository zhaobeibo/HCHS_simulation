42   
43   
44   /*------------------------------------------------------------*
45    | PARMS mapping (NO Level1)                                   |
46    | - Use ONLY Parameter/parm mapping                           |
47    | - age_strat_new: we will keep the row with non-missing Z     |
48    *------------------------------------------------------------*/
49   data parms;
50     length parm $20 Parameter $32;
51     input modelrhs parm $ Parameter $;
52     datalines;

NOTE: The data set WORK.PARMS has 7 observations and 3 variables.
NOTE: DATA statement used (Total process time):
      real time           0.03 seconds
      cpu time            0.03 seconds
      

60   ;
61   run;
62   
63   %macro impute_genmod(start=, end=, corr = );
64   
65   
66     %do i = &start %to &end;
67   
68       /*============================*
69        | 0) Read sample + recode    |
70        *============================*/
71       data samplemiss_&i;
72         /* set sampmiss.samplemiss_10pct_&i; */
73         set sampmiss.samplemiss_50pct_&i._;
74   
75         where miss_ind_mar = 0; /* remove missing visits */
76   
77         if strat in (1,5) then strat_recoded = 1;
78         else if strat in (2,6) then strat_recoded = 2;
79         else if strat in (3,7) then strat_recoded = 3;
80         else if strat in (4,8) then strat_recoded = 4;
81       run;
82   
83       proc sort data=samplemiss_&i;
84         by strat_recoded bgid hhid subid;
85       run;
86   
87       ods exclude all;
88       ods output GEEEmpPEst = betas_&corr._&i;   /* robust (empirical) PE table */
89       proc genmod data=samplemiss_&i ;
90         class hhid age_strat_new(ref = '0');
91         weight bghhsub_s2_v3_nr;  * use visit-3 adjusted weight;
92         model y_gfr = x17 x12 x18 y_bmi age_strat_new x6
93           / dist=normal link=identity;
94         repeated subject=hhid / type=ind ;
95       run;
96       ods output close;
97       ods exclude none;
98   
99   
100  
101  /*============================================================*
102   | 2) Standardize GENMOD output to match downstream merge       |
103   |    - Ignore Level1 entirely                                  |
104   |    - Keep only rows with non-missing Z (drops ref rows)       |
105   |    - For age_strat_new this keeps the estimable row (Z!=.)    |
106   *============================================================*/
107  
108  data betas_&corr._&i._prep;
109    set betas_&corr._&i;
110  
111    length Parameter $32;
112  
113    /* Map GENMOD name -> Parameter used for merge */
114    Parameter = strip(Parm);
115  
116    /* Keep only parameters we care about */
117    if upcase(Parameter) not in ("INTERCEPT","X17","X12","X18","Y_BMI","AGE_STRAT_NEW","X6") then
117! delete;
118  
119    /* Keep only estimable rows (reference rows have Z = .) */
120    if missing(Z) then delete;
121  
122    /* Create t-stat placeholder (combine code expects 't') */
123    t = Z;
124  
125    keep Parameter Estimate Stderr ProbZ t;
126  run;
127  
128  /* Sort for merge */
129  proc sort data=betas_&corr._&i._prep; by Parameter; run;
130  proc sort data=parms;                 by Parameter; run;
131  
132  /* Final output dataset matches your combine macro expectations */
133  data test2.&corr._rr_glm_mask_&i;
134    merge betas_&corr._&i._prep(in=a)
135          parms(in=b);
136    by Parameter;
137    if a;
138  
139    format Estimate Stderr 12.4;
140    keep modelrhs parm Estimate Stderr ProbZ t;
141  run;
142  
143  
144    %end;
145  
146  %mend impute_genmod;
147  
148  /* miss_ind_mar */
149  %impute_genmod(start=1, end=500, corr = ind);
