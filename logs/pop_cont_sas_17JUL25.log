404  
405  * Macro that fit a SAS GENMOD model with a continuous normal response;
406  %macro pop_sas(corr=);
407      options pagesize=60 linesize=80;
408  
409      title "[SAS GENMOD] &corr. correlation structure";
410  
411      proc genmod data=pop;
412          class subid;
413          model y_gfr = x17 x12 x18 y_bmi age_strat_new x6 / dist=normal;
414          repeated subject=subid / corr=&corr.;
415          ods output GEEEmpPEst=betas_&corr._temp;
416      run;
417  
418      * Process and format the output to match SUDAAN format;
419      data dt_betas.betas_pop_sas_&corr.;
420          set betas_&corr._temp;
421          length Parm $ 20;
422  
423          * Map parameter names;
424          if Parm = 'Intercept' then Parm = 'Intercept';
425          else if Parm = 'x17' then Parm = 'x17';
426          else if Parm = 'x12' then Parm = 'x12';
427          else if Parm = 'x18' then Parm = 'x18';
428          else if Parm = 'y_bmi' then Parm = 'y_bmi';
429          else if Parm = 'age_strat_new' then Parm = 'age_strat_new';
430          else if Parm = 'x6' then Parm = 'x6';
431  
432          * Rename variables to match SUDAAN output format;
433          Estimate = Estimate;
434          Stderr = StdErr;
435          ProbZ = ProbZ;
436          t = ZValue;
437  
438          keep Parm Estimate Stderr ProbZ t;
439      run;
440  
441      * Clean up temporary dataset;
442      proc datasets library=work nolist;
443          delete betas_&corr._temp;
444      quit;
445  %mend pop_sas;
