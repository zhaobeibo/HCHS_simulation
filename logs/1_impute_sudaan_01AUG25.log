NOTE: The data set WORK.VARS_LABELS has 7 observations and 2 variables.
NOTE: DATA statement used (Total process time):
      real time           0.04 seconds
      cpu time            0.01 seconds
      

37       ;
38   run;
39   
40   %macro impute_sudaan(start=2, end=100, corr=, corr_full=, rr=, miss=
40 ! ,nimpute=5);
41     %do i = &start. %to &end.;
42               data samp;
43                   set sample.samplemiss_&i;
44   
45                   /* weight adjusted for nomresponse */
46                   bghhsub_s2_nr = bghhsub_s2/ &rr.;
47   
48                   where &miss. = 0;
49               run;
50   
51               /* Transform from long to wide */
52                   /* This step is the preparation step for multiple
52 ! imputation */
53               data samp_1(rename=(x6=x6_1 y_bmi=y_bmi_1 y_gfr=y_gfr_1
53 ! bghhsub_s2_nr=w_nr_1))
54                       samp_2(rename=(x6=x6_2 y_bmi=y_bmi_2 y_gfr=y_gfr_2
54 ! bghhsub_s2_nr=w_nr_2))
55                       samp_3(rename=(x6=x6_3 y_bmi=y_bmi_3 y_gfr=y_gfr_3
55 ! bghhsub_s2_nr=w_nr_3));
56                   set samp;
57                   if v_num = 1 then output samp_1;
58                   else if v_num = 2 then output samp_2;
59                   else if v_num = 3 then output samp_3;
60               run;
61   
62               * Sort the 3 datasets;
63               proc sort data = samp_1; by subid; run;
64               proc sort data = samp_2; by subid; run;
65               proc sort data = samp_3; by subid; run;
66   
67                   * merging the 3 new datasets;
68               data samp_wide;
69                   merge samp_1-samp_3;
70                   by subid;
71               run;
72   
73                   * sort the output datasets;
74               proc sort data = samp_wide;
75                    by subid;
76               run;
77   
78                   * obtain the # of missing values by var ;
79               proc means data = samp_wide noprint;
80                    var  x17 x12 x18 y_bmi_1-y_bmi_3 age_strat_new
81                               x6_2-x6_3 y_gfr_1-y_gfr_3
82                               x14 w_nr_1 w_nr_2 w_nr_3;
83                   output out= mi_miss nmiss=;
84               run;
85   
86                   * transpose the values from proc means;
87               proc transpose data = mi_miss(drop=_TYPE_ _FREQ_)
87 ! out=mi_long;
88               run;
89   
90                   * sort the values by # missing;
91               proc sort data = mi_long;
92                       by col1;
93               run;
94   
95               proc sql noprint;
96                       select distinct _name_ into:var separated by ' '
96 ! from mi_long;
97               quit;
98               %put &var.;
99   
100              data samp_wide;
101                  set samp_wide;
102                  strat_psu = cats(strat_recoded,bgid);
103              run;
104  
105              proc mi data=samp_wide seed=2021 nimpute=&nimpute
105! out=samp_complete;
106                  class strat_psu;
107                  fcs reg(x6_2-x6_3 y_gfr_2-y_gfr_3 y_bmi_2-y_bmi_3);
108                  var &var. strat_psu;
109              run;
110  
111                  /* Transform the imputed datasets from wide format to
111! long */
112              data samp_long;
113                      set samp_complete;
114                      v_num = 1;
115                      x6 = x6_1;
116                      y_bmi = y_bmi_1;
117                      y_gfr = y_gfr_1;
118                      bghhsub_s2_nr = w_nr_1;
119                      output;
120  
121                      v_num = 2;
122                      x6 = x6_2;
123                      y_bmi = y_bmi_2;
124                      y_gfr = y_gfr_2;
125                      bghhsub_s2_nr = w_nr_2;
126                      output;
127  
128                      v_num = 3;
129                      x6 = x6_3;
130                      y_bmi = y_bmi_3;
131                      y_gfr = y_gfr_3;
132                      bghhsub_s2_nr = w_nr_3;
133                      output;
134              run;
135  
136                      * Fit regress model from sudaan using corr matrix;
137                  * Looping over the 5 simulated datasets;
138                  %do j = 1 %to &nimpute;
139                      data temp;
140                          set samp_long;
141                          if _imputation_ = &j;
142                      run;
143                  proc sort data = temp;
144                      by strat_recoded bgid hhid subid;
145                  run;
146                      options pagesize=60 linesize=80;
147                      proc regress data = temp filetype=sas r=&corr_full
147! semethod=zeger;
148                          %if &corr. = exch %then %do;
149                              nest strat_recoded hhid / psulev=2 ;
150                          %end;
151                          %else %do;
152                              nest strat_recoded hhid;
153                          %end;
154                          weight bghhsub_s2;
155                          model y_gfr = x17 x12 x18 y_bmi age_strat_new x6
155! ;
156                          output beta sebeta p_beta t_beta /
156! filename=betas_mi_&corr._&i._&j filetype=sas replace;
157                      run;
158  
159                      data betas_mi_&corr._&i._&j;
160                          merge vars_labels betas_mi_&corr._&i._&j ;
161                          by modelrhs;
162                          _imputation_ = &j;
163                          ClassVal0 = '';
164                          DF = 1;
165                          rename beta = Estimate sebeta = StdErr p_beta =
165! ProbChisq t_beta = WaldChisq;
166                          drop procnum modelno modelrhs;
167                      run;
168                  %end;
169          * merging the 10 datasets;
170          data outparms;
171              set betas_mi_&corr._&i._1 - betas_mi_&corr._&i._&nimpute.;
172          run;
173          * combine estimates;
174          proc mianalyze parms = outparms;
175              modeleffects intercept x17 x12 x18 y_bmi age_strat_new x6;
176              ods output ParameterEstimates = betas_mi_&corr._&i;
177          run;
178          data dt_b_s1.&corr._&rr._&i;
179                          SET betas_mi_&corr._&i(RENAME=(UCLMEAN = UPPERCL
179!  LCLMEAN=LOWERCL ));
180          run;
181    %end;
182  %mend impute_sudaan;
183  
184  * miss_ind_mar;
185  %impute_sudaan(corr=ind, corr_full=independent, rr=rr_glm, miss=
185! miss_ind_mar);

