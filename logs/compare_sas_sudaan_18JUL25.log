21   ************************************************************************
21 ! *********************************
22   
23           PROGRAM NAME: compare_sas_sudaan.sas
24           SOURCE:
25           DESCRIPTION:   Compare SAS GENMOD vs SUDAAN results by outcome
25 ! type and correlation structure
26           VERSION CONTROL:
27                               27mar25: create file
28   ************************************************************************
28 ! *********************************;
29   
30   * Set system options;
31   options mergenoby=warn ls=95 ps=54 nodate mprint formchar="|----|+|---+=|-/\<>*";
32   
33   * Macro to compare results for each outcome x correlation combination;
34   %macro compare_results(outcome=, corr=);
35   
36       * Read SAS and SUDAAN datasets;
37       %if &outcome. = cont %then %do;
38           data sas_data;
39               set dt_betas.betas_pop_sas_&corr.;
40               software = "SAS";
41               outcome = "Continuous";
42               correlation = "%upcase(&corr.)";
43           run;
44   
45           data sudaan_data;
46               set dt_betas.betas_pop_&corr.;
47               software = "SUDAAN";
48               outcome = "Continuous";
49               correlation = "%upcase(&corr.)";
50           run;
51       %end;
52       %else %if &outcome. = bin %then %do;
53           data sas_data;
54               set dt_betas.betas_pop_bin_sas_&corr.;
55               software = "SAS";
56               outcome = "Binary";
57               correlation = "%upcase(&corr.)";
58           run;
59   
60           data sudaan_data;
61               set dt_betas.betas_pop_bin_&corr.;
62               software = "SUDAAN";
63               outcome = "Binary";
64               correlation = "%upcase(&corr.)";
65           run;
66       %end;
67   
68       * Combine datasets;
69       data combined_&outcome._&corr.;
70           set sas_data sudaan_data;
71       run;
72   
73       * Create comparison dataset;
74       proc sort data=combined_&outcome._&corr.; by parm software; run;
75   
76       proc transpose data=combined_&outcome._&corr. out=wide_&outcome._&corr. prefix=;
77           by parm outcome correlation;
78           id software;
79           var estimate stderr probz t;
80       run;
81   
82       * Calculate differences and ratios;
83       data comparison_&outcome._&corr.;
84           set wide_&outcome._&corr.;
85   
86           * Calculate differences (SAS - SUDAAN);
87           estimate_diff = SAS_estimate - SUDAAN_estimate;
88           stderr_diff = SAS_stderr - SUDAAN_stderr;
89           probz_diff = SAS_probz - SUDAAN_probz;
90           t_diff = SAS_t - SUDAAN_t;
91   
92           * Calculate relative differences (as percentages);
93           if SUDAAN_estimate ne 0 then estimate_rel_diff = (estimate_diff / SUDAAN_estimate)
93 !  * 100;
94           if SUDAAN_stderr ne 0 then stderr_rel_diff = (stderr_diff / SUDAAN_stderr) * 100;
95           if SUDAAN_probz ne 0 then probz_rel_diff = (probz_diff / SUDAAN_probz) * 100;
96           if SUDAAN_t ne 0 then t_rel_diff = (t_diff / SUDAAN_t) * 100;
97   
98           * Calculate absolute relative differences;
99           abs_estimate_rel_diff = abs(estimate_rel_diff);
100          abs_stderr_rel_diff = abs(stderr_rel_diff);
101          abs_probz_rel_diff = abs(probz_rel_diff);
102          abs_t_rel_diff = abs(t_rel_diff);
103  
104          format estimate_diff stderr_diff probz_diff t_diff 12.6
105                 estimate_rel_diff stderr_rel_diff probz_rel_diff t_rel_diff 8.2
106                 abs_estimate_rel_diff abs_stderr_rel_diff abs_probz_rel_diff abs_t_rel_diff
106!  8.2;
107      run;
108  
109      * Print comparison results;
110      title1 "Comparison of SAS vs SUDAAN Results";
111      title2 "Outcome: %upcase(&outcome.) | Correlation: %upcase(&corr.)";
112      title3 "Raw Values";
113  
114      proc print data=combined_&outcome._&corr. noobs;
115          var parm software estimate stderr probz t;
116          format estimate stderr 12.6 probz t 8.4;
117      run;
118  
119      title3 "Differences and Relative Differences (%)";
120      proc print data=comparison_&outcome._&corr. noobs;
121          var parm outcome correlation
122              SAS_estimate SUDAAN_estimate estimate_diff estimate_rel_diff
123              SAS_stderr SUDAAN_stderr stderr_diff stderr_rel_diff
124              SAS_probz SUDAAN_probz probz_diff probz_rel_diff
125              SAS_t SUDAAN_t t_diff t_rel_diff;
126      run;
127  
128      * Summary statistics of differences;
129      title3 "Summary of Absolute Relative Differences (%)";
130      proc means data=comparison_&outcome._&corr. n mean std min max;
131          var abs_estimate_rel_diff abs_stderr_rel_diff abs_probz_rel_diff abs_t_rel_diff;
132      run;
133  
134  %mend compare_results;
135  
136  * Create overall comparison dataset;
137  data all_comparisons;
138      length outcome $10 correlation $12 software $10;
139      stop; * Initialize empty dataset;
140  run;

NOTE: Variable outcome is uninitialized.
NOTE: Variable correlation is uninitialized.
NOTE: Variable software is uninitialized.
