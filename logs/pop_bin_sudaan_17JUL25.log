374  * Macro that fit a SUDAAN model with a binary logistic response;
375  %macro pop(corr=, corr_full=);
376      options pagesize=60 linesize=80;
377      proc rlogist data = pop filetype=sas r=&corr_full semethod=zeger;
378          %if &corr. = exch %then %do;
379              nest strat_recoded bgid hhid / psulev=2 ;
380          %end;
381          %else %do;
382              nest strat_recoded bgid hhid;
383          %end;
384          weight _one_;
385          model y_bin_gfr = x17 x12 x18 y_bmi age_strat_new x6;
386          output beta sebeta p_beta t_beta / filename=betas_&corr. filetype=sas replace;
387      run;
388      * Append parameter names to sudaan output;
389      data dt_betas.betas_pop_bin_&corr;
390          merge betas_&corr.(rename=(BETA=Estimate SEBETA=Stderr P_BETA=ProbZ t_beta=t))
390! parms;
391          by modelrhs;
392          length parm $ 20;
393          drop procnum modelno modelrhs;
394      run;
395  %mend pop;
