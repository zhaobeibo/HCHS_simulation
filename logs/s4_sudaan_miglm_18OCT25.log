53   
54   %macro impute_sudaan(start=, end=, corr=, corr_full=, miss=);
55     %do i = &start. %to &end.;
56   
57   
58   /*============================*
59    | 1) Split to V1 / V2 / V3   |
60    *============================*/
61   data samp_1 samp_2 samp_3;
62     set sample.samplemiss_&i;
63     where &miss. = 0;   /* keep only non-missing per your flag */
64     if      v_num = 1 then output samp_1;
65     else if v_num = 2 then output samp_2;
66     else if v_num = 3 then output samp_3;
67   run;
68   
69   /* Sort all three and build unique ID lists for V2/V3 */
70   proc sort data = samp_1;                           by subid; run;
71   proc sort data = samp_2(keep = subid) out = v2_ids nodupkey; by subid;
71 ! run;
72   proc sort data = samp_3(keep = subid) out = v3_ids nodupkey; by subid;
72 ! run;
73   
74   /*=====================================================*
75    | 2) Add PARTICIPANT_V2 / PARTICIPANT_V3 to the V1   |
76    |    dataset BEFORE missingness + MI                 |
77    *=====================================================*/
78   data samp_1_w_flags;
79     merge samp_1(in = in_v1)
80           v2_ids(in = in_v2)
81           v3_ids(in = in_v3);
82     by subid;
83     if in_v1;
84     PARTICIPANT_V2 = (in_v2 = 1);
85     PARTICIPANT_V3 = (in_v3 = 1);
86   
87       /* Strata indicators: 1/0 flags */
88     length strata1 strata2 strata3 8;
89     strata1 = (strat in (1, 5));
90     strata2 = (strat in (2, 6));
91     strata3 = (strat in (3, 7));
92   run;
93   
94   /* Optional: quick check */
95   proc freq data = samp_1_w_flags;
96     tables PARTICIPANT_V2 PARTICIPANT_V3 / missing;
97   run;
98   
99   /*====================================================*
100   | 3) Inject ~20% MCAR missingness for V1 variables   |
101   *====================================================*/
102  data samp_1_miss;
103    set samp_1_w_flags;
104    array missvars age_base x12 x14;   /* variables to blank */
105    do over missvars;
106      if rand('uniform') < 0.05 then missvars = .;
107    end;
108  run;
109  
110  /* Optional: sanity check */
111  proc means data = samp_1_miss n nmiss;
112    var age_base x12 x14;
113  run;
114  
115  /*========================================*
116   | 4) Multiple Imputation on V1 dataset   |
117   *========================================*/
118  proc mi data = samp_1_miss seed = 2021 nimpute = 5 out = samp_complete;
119    class strata1 strata2 strata3 x12 x14;
120    var strata1 strata2 strata3 age_base x12 x14 bghhsub_s2;
121    fcs reg(age_base);          /* continuous */
122    fcs logistic(x12 x14);      /* binary/categorical */
123  run;
124  
125  /*===========================*
126   | 5) IPW prediction models  |
127   *===========================*/
128  
129  /* = Visit 2: logistic */
130  proc logistic data = samp_complete descending noprint;
131    by _Imputation_;
132    class strata1 strata2 strata3 x12 x14 PARTICIPANT_V2;
133    model PARTICIPANT_V2 = strata1 strata2 strata3 age_base x12 x14 ;
134    output out = pred_v2_imp(keep = _Imputation_ subid xb_v2) xbeta =
134! xb_v2;
135  run;
136  
137  proc means data = pred_v2_imp nway noprint;
138    class subid;
139    var xb_v2;
140    output out = pred_v2_bar(drop = _type_ _freq_) mean = xb_v2_bar;
141  run;
142  
143  /* = Visit 3: logistic */
144  proc logistic data = samp_complete descending noprint;
145    by _Imputation_;
146    class strata1 strata2 strata3 x12 x14 PARTICIPANT_V2 PARTICIPANT_V3;
147    model PARTICIPANT_V3 = strata1 strata2 strata3 age_base x12 x14
147! PARTICIPANT_V2;
148    output out = pred_v3_imp(keep = _Imputation_ subid xb_v3) xbeta =
148! xb_v3;
149  run;
150  
151  proc means data = pred_v3_imp nway noprint;
152    class subid;
153    var xb_v3;
154    output out = pred_v3_bar(drop = _type_ _freq_) mean = xb_v3_bar;
155  run;
156  
157  /*===========================*
158   | 6) Compute response rates |
159   *===========================*/
160  proc sort data = pred_v2_bar; by subid; run;
161  proc sort data = pred_v3_bar; by subid; run;
162  
163  data samp_ipw;
164    merge pred_v2_bar(rename = (xb_v2_bar = lp_v2))
165          pred_v3_bar(rename = (xb_v3_bar = lp_v3));
166    by subid;
167  
168    /* Predicted response rates */
169    if not missing(lp_v2) then RR_V2 = 1 / (1 + exp(-lp_v2));
170    if not missing(lp_v3) then RR_V3 = 1 / (1 + exp(-lp_v3));
171  run;
172  
173  
174  
175  
176  /* --- Starting from samp_ipw already created --- */
177  data samp_ipw_long(keep = subid v_num rr_glm_mask);
178    set samp_ipw;
179  
180    /* Visit 1: rr_glm_mask = 1 */
181    v_num  = 1; rr_glm_mask = 1;      output;
182  
183    /* Visit 2: rr_glm_mask = RR_V2 */
184    v_num  = 2; rr_glm_mask = RR_V2;  output;
185  
186    /* Visit 3: rr_glm_mask = RR_V3 */
187    v_num  = 3; rr_glm_mask = RR_V3;  output;
188  run;
189  
190  proc sort data = samp_ipw_long; by subid v_num; run;
191  
192  /* Bring in the base sample restricted by &miss. */
193  data sampmiss;
194    set sample.samplemiss_&i;
195    where &miss. = 0;
196  run;
197  
198  proc sort data = sampmiss; by subid v_num; run;
199  
200  /* Merge the rr_glm_mask and compute nonresponse-adjusted weight */
201  data samp;
202    merge sampmiss(in = a)
203          samp_ipw_long(in = b);
204    by subid v_num;
205  
206    if a;
207  
208    /* weight adjusted for nonresponse */
209    bghhsub_s2_nr = bghhsub_s2 / rr_glm_mask;
210  run;
211  
212  
213      /* Sort samp by subid for merging */
214      proc sort data = samp;
215          by subid;
216      run;
217  
218      /* Step 1: Create a dataset with subid in V3 */
219      proc sql;
220         create table valid_subid as
221         select distinct subid
222         from samp
223         where v_num = 3;
224      quit;
225  
226      /* Sort valid_subid by subid for merging */
227      proc sort data = valid_subid;
228          by subid;
229      run;
230  
231      /* Step 2: Merge samp with valid_subid to keep only valid subids */
232      data samp_filtered;
233         merge samp(in=a) valid_subid(in=b);
234         by subid;
235         if b;  /* Only keep records from samp where subid is in
235! valid_subid */
236      run;
237  
238      /* Step 3: Create a dataset with the value of bghhsub_s2_nr for
238! v_num = 3 for each subid */
239      proc sql;
240         create table temp as
241         select subid, bghhsub_s2_nr as bghhsub_s2_v3_nr
242         from samp_filtered
243         where v_num = 3;
244      quit;
245  
246      /* Step 4: Merge the new variable back into the filtered dataset */
247      data samplemiss_&i._;
248         merge samp_filtered temp;
249         by subid;
250      run;
251  
252      /* Order data */
253      proc sort data = samplemiss_&i._;
254          by strat_recoded bgid hhid subid;
255      run;
256  
257  
258      * Fit regress model from sudaan using &corr matrix;
259          * In a simulation group meeting it was requested to use hhid as
259! PSUs instead of bgid;
260      options pagesize=60 linesize=80;
261      proc regress data = samplemiss_&i._ filetype=sas r=&corr_full
261! semethod=zeger;
262          %if  &corr. = exch %then %do;
263              nest strat_recoded hhid / psulev=2 ;
264          %end;
265          %else %do;
266              nest strat_recoded hhid;
267          %end;
268          weight bghhsub_s2_v3_nr;    *use visit-3 adjusted weight;
269          model y_gfr = x17 x12 x18 y_bmi age_strat_new x6;
270          output beta sebeta p_beta t_beta / filename=betas_&corr._&i._
270! filetype=sas replace;
271      run;
272  
273      * Append parameter names to sudaan output;
274      data test2.&corr._rr_glm_mask_&i;
275          merge betas_&corr._&i._(rename=(BETA=Estimate SEBETA=Stderr
275! P_BETA=ProbZ t_beta=t)) parms;
276          by modelrhs;
277          length parm $ 20;
278          format Estimate Stderr 12.4;
279          drop procnum modelno modelrhs;
280      run;
281  
282  
283    %end;
284  %mend impute_sudaan;
285  
286  * miss_ind_mar;
287  %impute_sudaan(start=101, end=200, corr=ind, corr_full=independent,
287! miss= miss_ind_mar);

