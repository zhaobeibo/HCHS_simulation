65   %macro impute_genmod(start=, end=, corr = , rr_glm = );
66   
67   
68     %do i = &start %to &end;
69   
70   
71       /*============================*
72        | 0a) Import CSV + handle NA |
73        *============================*/
74       proc import datafile="&datapath./samplemiss_&i..csv"
75           out=samplemiss_&i._raw
76           dbms=csv
77           replace;
78           guessingrows=max;
79       run;
80   
81   
82       /*========================================================*
83    | Semi-automatic conversion of character vars containing |
84    | "NA" to numeric vars with SAS missing (.)              |
85    *========================================================*/
86   
87   /* 1) Get all character variable names */
88   proc contents data=samplemiss_&i._raw out=_vars_(keep=name type) noprint
88 ! ;
89   run;
90   
91   proc sql noprint;
92       select name
93       into :char_vars separated by ' '
94       from _vars_
95       where type = 2;
96   quit;
97   
98   /* 2) Find which character variables contain at least one "NA" */
99   %macro find_na_vars;
100      %global na_vars;
101      %let na_vars=;
102  
103      %let n=%sysfunc(countw(&char_vars));
104      %do j=1 %to &n;
105          %let v=%scan(&char_vars, &j);
106  
107          proc sql noprint;
108              select count(*)
109              into :has_na trimmed
110              from samplemiss_&i._raw
111              where strip(&v) = "NA";
112          quit;
113  
114          %if &has_na > 0 %then %do;
115              %let na_vars=&na_vars &v;
116          %end;
117      %end;
118  %mend;
119  
120  %find_na_vars
121  
122  %put NOTE: Variables containing NA = &na_vars;
123  
124  /* 3) Convert only those variables to numeric */
125  data samplemiss_&i._raw1;
126      set samplemiss_&i._raw;
127  
128      %let n_na=%sysfunc(countw(&na_vars));
129  
130      %do j=1 %to &n_na;
131          %let v=%scan(&na_vars, &j);
132          &v._num = input(strip(&v), best.);
133      %end;
134  
135      drop
136      %do j=1 %to &n_na;
137          %let v=%scan(&na_vars, &j);
138          &v
139      %end;
140      ;
141  
142      rename
143      %do j=1 %to &n_na;
144          %let v=%scan(&na_vars, &j);
145          &v._num = &v
146      %end;
147      ;
148  run;
149  
150      /*============================*
151       | 0) Read sample + recode    |
152       *============================*/
153      data samplemiss_&i;
154        set samplemiss_&i._raw1;
155  
156        where miss_ind_mar = 0; /* remove missing visits */
157  
158        if strat in (1,5) then strat_recoded = 1;
159        else if strat in (2,6) then strat_recoded = 2;
160        else if strat in (3,7) then strat_recoded = 3;
161        else if strat in (4,8) then strat_recoded = 4;
162  
163          if upcase(strip(age_strat)) = 'TRUE' then age_strat_new = 1;
164          else if upcase(strip(age_strat)) = 'FALSE' then age_strat_new =
164! 0;
165          else age_strat_new = .;
166      run;
167  
168      proc sort data=samplemiss_&i;
169        by strat_recoded bgid hhid subid;
170      run;
171  
172      ods exclude all;
173      ods output GEEEmpPEst = betas_&corr._&i;   /* robust (empirical) PE
173! table */
174      proc genmod data=samplemiss_&i ;
175        class hhid age_strat_new(ref = '0');
176        weight &rr_glm.;
177        model y_gfr = x17 x12 x18 y_bmi age_strat_new x6
178          / dist=normal link=identity;
179        repeated subject=hhid / type=ind ;
180      run;
181      ods output close;
182      ods exclude none;
183  
184  
185  
186  /*============================================================*
187   | 2) Standardize GENMOD output to match downstream merge       |
188   |    - Ignore Level1 entirely                                  |
189   |    - Keep only rows with non-missing Z (drops ref rows)       |
190   |    - For age_strat_new this keeps the estimable row (Z!=.)    |
191   *============================================================*/
192  
193  data betas_&corr._&i._prep;
194    set betas_&corr._&i;
195  
196    length Parameter $32;
197  
198    /* Map GENMOD name -> Parameter used for merge */
199    Parameter = strip(Parm);
200  
201    /* Keep only parameters we care about */
202    if upcase(Parameter) not in
202! ("INTERCEPT","X17","X12","X18","Y_BMI","AGE_STRAT_NEW","X6") then delete
202! ;
203  
204    /* Keep only estimable rows (reference rows have Z = .) */
205    if missing(Z) then delete;
206  
207    /* Create t-stat placeholder (combine code expects 't') */
208    t = Z;
209  
210    keep Parameter Estimate Stderr ProbZ t;
211  run;
212  
213  /* Sort for merge */
214  proc sort data=betas_&corr._&i._prep; by Parameter; run;
215  proc sort data=parms;                 by Parameter; run;
216  
217  /* Final output dataset matches your combine macro expectations */
218  data missout.&corr._rr_glm_&i;
219    merge betas_&corr._&i._prep(in=a)
220          parms(in=b);
221    by Parameter;
222    if a;
223  
224    format Estimate Stderr 12.4;
225    keep modelrhs parm Estimate Stderr ProbZ t;
226  run;
227  
228  
229    %end;
230  
231  %mend impute_genmod;
