655  
656  * Macro that fit a SUDAAN model with a continuous normal response;
657  %macro pop(corr=);
658      options pagesize=60 linesize=80;
659      proc regress data = pop filetype=sas r=&corr semethod=zeger;
660          %if &corr. = exchangeable %then %do;
661              nest strat_recoded bgid hhid / psulev=2 ;
662          %end;
663          %else %do;
664              nest strat_recoded bgid hhid;
665          %end;
666          weight _one_;
667          model y_gfr = x17 x12 x18 y_bmi age_strat_new x6;
668          output beta sebeta p_beta t_beta / filename=betas_&corr. filetype=sas replace;
669      run;
670  
671      * Append parameter names to sudaan output;
672      data dt_betas.betas_pop_&corr;
673          merge betas_&corr.(rename=(BETA=Estimate SEBETA=Stderr P_BETA=ProbZ t_beta=t))
673! parms;
674          by modelrhs;
675          length parm $ 20;
676          drop procnum modelno modelrhs;
677      run;
678  %mend pop;
679  
680  * Create dataset with parms labels;
681  data parms;
682  length Parm $ 15;
683  input modelrhs parm $;
684  datalines;

