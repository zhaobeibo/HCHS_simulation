40   *************************************************************************************************
40 ! ********
41   
42           PROGRAM NAME: combine_sudaan.sas
43           PROGRAMMER: Beibo Zhao (updated from AQA)
44           DESCRIPTION: Combine results and calculate performance metrics for HCHS V3 simulation
45           VERSION CONTROL:
46                           - 24APR25: Initialize the code (AQA)
47                           - Aug2025: Updated for consistency with R simulation framework (BZ)
48                           - Modified: Handle missing datasets from 1-1000, skip non-existent files
49   *************************************************************************************************
49 ! ********;
50   
51   %macro combine_con_betas(start=, end=, corr=, corr_full = , rr=,
52                          input_lib=, pop_lib=dt_betas, output_lib=outpath);
53   
54       /* Create a temporary dataset to hold all existing files */
55       data merge_betas;
56           /* Initialize empty dataset with correct structure */
57           length parm $20;
58           if 0; /* This creates structure but no observations */
59       run;
60   
61       /* Counter for successful merges */
62       %let merge_count = 0;
63   
64       /* Loop through each file number and check if it exists */
65       %do i = &start %to &end;
66           /* Check if dataset exists using SASHELP.VTABLE or by attempting to open */
67           %if %sysfunc(exist(&input_lib..&corr.&rr.&i.)) %then %do;
68               /* Dataset exists, append it */
69               data merge_betas;
70                   set merge_betas &input_lib..&corr.&rr.&i.;
71                   if parm = 'intercept' then parm = 'Intercept';
72               run;
73               %let merge_count = %eval(&merge_count + 1);
74               %put NOTE: Successfully merged dataset &input_lib..&corr.&rr.&i. (File &merge_count);
75           %end;
76           %else %do;
77               %put WARNING: Dataset &input_lib..&corr.&rr.&i. does not exist - skipping;
78           %end;
79       %end;
80   
81       %put NOTE: Total datasets merged: &merge_count out of %eval(&end - &start + 1) possible files
81 ! ;
82   
83       /* Check if we have any data to process */
84       %let dsid = %sysfunc(open(merge_betas));
85       %let nobs = %sysfunc(attrn(&dsid, nobs));
86       %let rc = %sysfunc(close(&dsid));
87   
88       %if &nobs = 0 %then %do;
89           %put ERROR: No datasets found to merge for &input_lib..&corr.&rr. - exiting macro;
90           %return;
91       %end;
92   
93       /* Append the true value coming from population estimates */
94       proc sql;
95           create table betas_samp_pop as
96           select a.*, b.estimate as true
97           from merge_betas as a
98           right join
99           &pop_lib..betas_pop_&corr. as b
100          on a.parm=b.parm;
101      quit;
102  
103      /* Compute 95% confidence intervals */
104      data betas_samp_pop;
105          set betas_samp_pop;
106          uppercl = Estimate + 1.975 * Stderr;
107          lowercl = Estimate - 1.975 * Stderr;
108      run;
109  
110      /* Estimate quantities of interest: bias, ... */
111      data betas_samp_pop_;
112          set betas_samp_pop;
113          /* Calculate statistics to summarize */
114          inci = (uppercl >= true & lowercl <= true);
115          bias = estimate - true;
116          relbias = bias / true;
117          /* PROBT */
118          rejecth0 = (abs(t) > quantile('NORMAL',.975));
119      run;
120  
121      /* Calculate summary statistics */
122      proc means data=betas_samp_pop_ noprint nway;
123          class parm;
124          var true estimate bias relbias stderr inci rejecth0;
125          output out=output_1 mean(true estimate bias relbias stderr inci
126                  rejecth0)=true estimate empbias relbias estse coverage
127                  prejecth0 std(estimate)=empse;
128      run;
129  
130      /* Final calculations */
131      data output;
132          set output_1;
133          relse = estse/empse - 1;
134          /* Add information about number of files merged */
135          files_merged = &merge_count;
136      run;
137  
138      /* Save output dataset */
139      data &output_lib..&input_lib._&corr.&rr.;
140          set output;
141      run;
142  
143      /* Clean up temporary datasets */
144      proc datasets library=work nolist;
145          delete merge_betas betas_samp_pop betas_samp_pop_ output_1 output;
146      quit;
147  
148  %mend combine_con_betas;
149  
150  
151  * s1 - MI scenarios;
152  * miss_ind_mar scenarios;
153  /*%combine_con_betas(start=1, end=100, corr=ind, corr_full=independent, rr=_double_rr_, */
154  /*                 input_lib=test1);*/
155  
156  %combine_con_betas(start=1, end=500, corr=ind, corr_full=independent, rr=_rr_glm_mask_,
157                   input_lib=test2);

