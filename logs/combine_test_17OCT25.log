483   
484   **************************************************************************
484 ! *******************************
485   
486           PROGRAM NAME: combine_sudaan.sas
487           PROGRAMMER: Beibo Zhao (updated from AQA)
488           DESCRIPTION: Combine results and calculate performance metrics for
488 !  HCHS V3 simulation
489           VERSION CONTROL:
490                           - 24APR25: Initialize the code (AQA)
491                           - Aug2025: Updated for consistency with R
491 ! simulation framework (BZ)
492                           - Modified: Handle missing datasets from 1-1000,
492 ! skip non-existent files
493   **************************************************************************
493 ! *******************************;
494   
495   %macro combine_con_betas(start=, end=, corr=, corr_full = , rr=,
496                          input_lib=, pop_lib=dt_betas, output_lib=outpath);
497   
498       /* Create a temporary dataset to hold all existing files */
499       data merge_betas;
500           /* Initialize empty dataset with correct structure */
501           length parm $20;
502           if 0; /* This creates structure but no observations */
503       run;
504   
505       /* Counter for successful merges */
506       %let merge_count = 0;
507   
508       /* Loop through each file number and check if it exists */
509       %do i = &start %to &end;
510           /* Check if dataset exists using SASHELP.VTABLE or by attempting
510 ! to open */
511           %if %sysfunc(exist(&input_lib..&corr.&rr.&i.)) %then %do;
512               /* Dataset exists, append it */
513               data merge_betas;
514                   set merge_betas &input_lib..&corr.&rr.&i.;
515                   if parm = 'intercept' then parm = 'Intercept';
516               run;
517               %let merge_count = %eval(&merge_count + 1);
518               %put NOTE: Successfully merged dataset
518 ! &input_lib..&corr.&rr.&i. (File &merge_count);
519           %end;
520           %else %do;
521               %put WARNING: Dataset &input_lib..&corr.&rr.&i. does not exist
521 !  - skipping;
522           %end;
523       %end;
524   
525       %put NOTE: Total datasets merged: &merge_count out of %eval(&end -
525 ! &start + 1) possible files;
526   
527       /* Check if we have any data to process */
528       %let dsid = %sysfunc(open(merge_betas));
529       %let nobs = %sysfunc(attrn(&dsid, nobs));
530       %let rc = %sysfunc(close(&dsid));
531   
532       %if &nobs = 0 %then %do;
533           %put ERROR: No datasets found to merge for &input_lib..&corr.&rr.
533 ! - exiting macro;
534           %return;
535       %end;
536   
537       /* Append the true value coming from population estimates */
538       proc sql;
539           create table betas_samp_pop as
540           select a.*, b.estimate as true
541           from merge_betas as a
542           right join
543           &pop_lib..betas_pop_&corr. as b
544           on a.parm=b.parm;
545       quit;
546   
547       /* Compute 95% confidence intervals */
548       data betas_samp_pop;
549           set betas_samp_pop;
550           uppercl = Estimate + 1.975 * Stderr;
551           lowercl = Estimate - 1.975 * Stderr;
552       run;
553   
554       /* Estimate quantities of interest: bias, ... */
555       data betas_samp_pop_;
556           set betas_samp_pop;
557           /* Calculate statistics to summarize */
558           inci = (uppercl >= true & lowercl <= true);
559           bias = estimate - true;
560           relbias = bias / true;
561           /* PROBT */
562           rejecth0 = (abs(t) > quantile('NORMAL',.975));
563       run;
564   
565       /* Calculate summary statistics */
566       proc means data=betas_samp_pop_ noprint nway;
567           class parm;
568           var true estimate bias relbias stderr inci rejecth0;
569           output out=output_1 mean(true estimate bias relbias stderr inci
570                   rejecth0)=true estimate empbias relbias estse coverage
571                   prejecth0 std(estimate)=empse;
572       run;
573   
574       /* Final calculations */
575       data output;
576           set output_1;
577           relse = estse/empse - 1;
578           /* Add information about number of files merged */
579           files_merged = &merge_count;
580       run;
581   
582       /* Save output dataset */
583       data &output_lib..&input_lib._&corr.&rr.;
584           set output;
585       run;
586   
587       /* Clean up temporary datasets */
588       proc datasets library=work nolist;
589           delete merge_betas betas_samp_pop betas_samp_pop_ output_1 output;
590       quit;
591   
592   %mend combine_con_betas;
593   
594   
595   * s1 - MI scenarios;
596   * miss_ind_mar scenarios;
597   %combine_con_betas(start=1, end=100, corr=ind, corr_full=independent,
597 ! rr=_double_rr_,
598                    input_lib=test1);

