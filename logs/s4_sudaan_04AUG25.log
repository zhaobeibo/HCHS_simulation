NOTE: The data set WORK.PARMS has 7 observations and 2 variables.
NOTE: DATA statement used (Total process time):
      real time           0.01 seconds
      cpu time            0.00 seconds
      

48   ;
49   run;
50   
51   %macro impute_sudaan(start=, end=, corr=, corr_full=, rr=, miss=);
52     %do i = &start. %to &end.;
53   
54       data samp;
55           set sample.samplemiss_&i;
56   
57           /* weight adjusted for nomresponse */
58           bghhsub_s2_nr = bghhsub_s2/ &rr.;
59   
60           where &miss. = 0;
61       run;
62   
63       /* Sort samp by subid for merging */
64       proc sort data = samp;
65           by subid;
66       run;
67   
68       /* Step 1: Create a dataset with subid in V3 */
69       proc sql;
70          create table valid_subid as
71          select distinct subid
72          from samp
73          where v_num = 3;
74       quit;
75   
76       /* Sort valid_subid by subid for merging */
77       proc sort data = valid_subid;
78           by subid;
79       run;
80   
81       /* Step 2: Merge samp with valid_subid to keep only valid subids */
82       data samp_filtered;
83          merge samp(in=a) valid_subid(in=b);
84          by subid;
85          if b;  /* Only keep records from samp where subid is in
85 ! valid_subid */
86       run;
87   
88       /* Step 3: Create a dataset with the value of bghhsub_s2_nr for
88 ! v_num = 3 for each subid */
89       proc sql;
90          create table temp as
91          select subid, bghhsub_s2_nr as bghhsub_s2_v3_nr
92          from samp_filtered
93          where v_num = 3;
94       quit;
95   
96       /* Step 4: Merge the new variable back into the filtered dataset */
97       data samplemiss_&i._;
98          merge samp_filtered temp;
99          by subid;
100      run;
101  
102      /* Order data */
103      proc sort data = samplemiss_&i._;
104          by strat_recoded bgid hhid subid;
105      run;
106  
107  
108      * Fit regress model from sudaan using &corr matrix;
109          * In a simulation group meeting it was requested to use hhid as
109! PSUs instead of bgid;
110      options pagesize=60 linesize=80;
111      proc regress data = samplemiss_&i._ filetype=sas r=&corr_full
111! semethod=zeger;
112          %if  &corr. = exch %then %do;
113              nest strat_recoded hhid / psulev=2 ;
114          %end;
115          %else %do;
116              nest strat_recoded hhid;
117          %end;
118          weight bghhsub_s2_v3_nr;    *use visit-3 adjusted weight;
119          model y_gfr = x17 x12 x18 y_bmi age_strat_new x6;
120          output beta sebeta p_beta t_beta / filename=betas_&corr._&i._
120! filetype=sas replace;
121      run;
122  
123      * Append parameter names to sudaan output;
124      data s4.&corr._&rr._&i;
125          merge betas_&corr._&i._(rename=(BETA=Estimate SEBETA=Stderr
125! P_BETA=ProbZ t_beta=t)) parms;
126          by modelrhs;
127          length parm $ 20;
128          format Estimate Stderr 12.4;
129          drop procnum modelno modelrhs;
130      run;
131  
132  
133    %end;
134  %mend impute_sudaan;
135  
136  * miss_ind_mar;
137  %impute_sudaan(start=1, end=500, corr=ind, corr_full=independent,
137! rr=rr_glm, miss= miss_ind_mar);

