558  ;
559  run;
560  
561  %macro impute_sudaan(start=, end=, corr=, corr_full=, miss=);
562    %do i = &start. %to &end.;
563  
564  
565  /*============================*
566   | 1) Split to V1 / V2 / V3   |
567   *============================*/
568  data samp_1 samp_2 samp_3;
569    set sample.samplemiss_&i;
570    where &miss. = 0;   /* keep only non-missing per your flag */
571    if      v_num = 1 then output samp_1;
572    else if v_num = 2 then output samp_2;
573    else if v_num = 3 then output samp_3;
574  run;
575  
576  /* Sort all three and build unique ID lists for V2/V3 */
577  proc sort data = samp_1;                           by subid; run;
578  proc sort data = samp_2(keep = subid) out = v2_ids nodupkey; by subid; run;
579  proc sort data = samp_3(keep = subid) out = v3_ids nodupkey; by subid; run;
580  
581  /*=====================================================*
582   | 2) Add PARTICIPANT_V2 / PARTICIPANT_V3 to the V1   |
583   |    dataset BEFORE missingness + MI                 |
584   *=====================================================*/
585  data samp_1_w_flags;
586    merge samp_1(in = in_v1)
587          v2_ids(in = in_v2)
588          v3_ids(in = in_v3);
589    by subid;
590    if in_v1;
591    PARTICIPANT_V2 = (in_v2 = 1);
592    PARTICIPANT_V3 = (in_v3 = 1);
593  run;
594  
595  /* Optional: quick check */
596  proc freq data = samp_1_w_flags;
597    tables PARTICIPANT_V2 PARTICIPANT_V3 / missing;
598  run;
599  
600  /*====================================================*
601   | 3) Inject ~20% MCAR missingness for V1 variables   |
602   *====================================================*/
603  data samp_1_miss;
604    set samp_1_w_flags;
605    array missvars age_base x12 x14;   /* variables to blank */
606    do over missvars;
607      if rand('uniform') < 0.20 then missvars = .;
608    end;
609  run;
610  
611  /* Optional: sanity check */
612  proc means data = samp_1_miss n nmiss;
613    var age_base x12 x14;
614  run;
615  
616  /*========================================*
617   | 4) Multiple Imputation on V1 dataset   |
618   *========================================*/
619  proc mi data = samp_1_miss seed = 2021 nimpute = 5 out = samp_complete;
620    class strat x12 x14;
621    var strat age_base x12 x14 bghhsub_s2;
622    fcs reg(age_base);          /* continuous */
623    fcs logistic(x12 x14);      /* binary/categorical */
624  run;
625  
626  /*===========================*
627   | 5) IPW prediction models  |
628   *===========================*/
629  
630  /* = Visit 2: logistic */
631  proc logistic data = samp_complete descending noprint;
632    by _Imputation_;
633    class strat x12 x14 PARTICIPANT_V2;
634    model PARTICIPANT_V2 = strat x12 x14 bghhsub_s2;
635    output out = pred_v2_imp(keep = _Imputation_ subid xb_v2) xbeta = xb_v2;
636  run;
637  
638  proc means data = pred_v2_imp nway noprint;
639    class subid;
640    var xb_v2;
641    output out = pred_v2_bar(drop = _type_ _freq_) mean = xb_v2_bar;
642  run;
643  
644  /* = Visit 3: logistic */
645  proc logistic data = samp_complete descending noprint;
646    by _Imputation_;
647    class strat x12 x14 PARTICIPANT_V2 PARTICIPANT_V3;
648    model PARTICIPANT_V3 = strat x12 x14 bghhsub_s2 PARTICIPANT_V2;
649    output out = pred_v3_imp(keep = _Imputation_ subid xb_v3) xbeta = xb_v3;
650  run;
651  
652  proc means data = pred_v3_imp nway noprint;
653    class subid;
654    var xb_v3;
655    output out = pred_v3_bar(drop = _type_ _freq_) mean = xb_v3_bar;
656  run;
657  
658  /*===========================*
659   | 6) Compute response rates |
660   *===========================*/
661  proc sort data = pred_v2_bar; by subid; run;
662  proc sort data = pred_v3_bar; by subid; run;
663  
664  data samp_ipw;
665    merge pred_v2_bar(rename = (xb_v2_bar = lp_v2))
666          pred_v3_bar(rename = (xb_v3_bar = lp_v3));
667    by subid;
668  
669    /* Predicted response rates */
670    if not missing(lp_v2) then RR_V2 = 1 / (1 + exp(-lp_v2));
671    if not missing(lp_v3) then RR_V3 = 1 / (1 + exp(-lp_v3));
672  run;
673  
674  
675  
676  
677  /* --- Starting from samp_ipw already created --- */
678  data samp_ipw_long(keep = subid v_num rr_glm_mask);
679    set samp_ipw;
680  
681    /* Visit 1: rr_glm_mask = 1 */
682    v_num  = 1; rr_glm_mask = 1;      output;
683  
684    /* Visit 2: rr_glm_mask = RR_V2 */
685    v_num  = 2; rr_glm_mask = RR_V2;  output;
686  
687    /* Visit 3: rr_glm_mask = RR_V3 */
688    v_num  = 3; rr_glm_mask = RR_V3;  output;
689  run;
690  
691  proc sort data = samp_ipw_long; by subid v_num; run;
692  
693  /* Bring in the base sample restricted by &miss. */
694  data sampmiss;
695    set sample.samplemiss_&i;
696    where &miss. = 0;
697  run;
698  
699  proc sort data = sampmiss; by subid v_num; run;
700  
701  /* Merge the rr_glm_mask and compute nonresponse-adjusted weight */
702  data samp;
703    merge sampmiss(in = a)
704          samp_ipw_long(in = b);
705    by subid v_num;
706  
707    if a;
708  
709    /* weight adjusted for nonresponse */
710    bghhsub_s2_nr = bghhsub_s2 / rr_glm_mask;
711  run;
712  
713  
714      /* Sort samp by subid for merging */
715      proc sort data = samp;
716          by subid;
717      run;
718  
719      /* Step 1: Create a dataset with subid in V3 */
720      proc sql;
721         create table valid_subid as
722         select distinct subid
723         from samp
724         where v_num = 3;
725      quit;
726  
727      /* Sort valid_subid by subid for merging */
728      proc sort data = valid_subid;
729          by subid;
730      run;
731  
732      /* Step 2: Merge samp with valid_subid to keep only valid subids */
733      data samp_filtered;
734         merge samp(in=a) valid_subid(in=b);
735         by subid;
736         if b;  /* Only keep records from samp where subid is in valid_subid
736! */
737      run;
738  
739      /* Step 3: Create a dataset with the value of bghhsub_s2_nr for v_num =
739!  3 for each subid */
740      proc sql;
741         create table temp as
742         select subid, bghhsub_s2_nr as bghhsub_s2_v3_nr
743         from samp_filtered
744         where v_num = 3;
745      quit;
746  
747      /* Step 4: Merge the new variable back into the filtered dataset */
748      data samplemiss_&i._;
749         merge samp_filtered temp;
750         by subid;
751      run;
752  
753      /* Order data */
754      proc sort data = samplemiss_&i._;
755          by strat_recoded bgid hhid subid;
756      run;
757  
758  
759      * Fit regress model from sudaan using &corr matrix;
760          * In a simulation group meeting it was requested to use hhid as
760! PSUs instead of bgid;
761      options pagesize=60 linesize=80;
762      proc regress data = samplemiss_&i._ filetype=sas r=&corr_full
762! semethod=zeger;
763          %if  &corr. = exch %then %do;
764              nest strat_recoded hhid / psulev=2 ;
765          %end;
766          %else %do;
767              nest strat_recoded hhid;
768          %end;
769          weight bghhsub_s2_v3_nr;    *use visit-3 adjusted weight;
770          model y_gfr = x17 x12 x18 y_bmi age_strat_new x6;
771          output beta sebeta p_beta t_beta / filename=betas_&corr._&i._
771! filetype=sas replace;
772      run;
773  
774      * Append parameter names to sudaan output;
775      data test2.&corr._rr_glm_mask_&i;
776          merge betas_&corr._&i._(rename=(BETA=Estimate SEBETA=Stderr
776! P_BETA=ProbZ t_beta=t)) parms;
777          by modelrhs;
778          length parm $ 20;
779          format Estimate Stderr 12.4;
780          drop procnum modelno modelrhs;
781      run;
782  
783  
784    %end;
785  %mend impute_sudaan;
786  
787  * miss_ind_mar;
788  %impute_sudaan(start=1, end=100, corr=ind, corr_full=independent, miss=
788! miss_ind_mar);

