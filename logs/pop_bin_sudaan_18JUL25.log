1542  * Macro that fit a SUDAAN model with a binary logistic response;
1543  %macro pop(corr=, corr_full=);
1544      options pagesize=60 linesize=80;
1545      proc rlogist data = pop filetype=sas r=&corr_full semethod=zeger;
1546          %if &corr. = exch %then %do;
1547              nest strat_recoded bgid hhid / psulev=2 ;
1548          %end;
1549          %else %do;
1550              nest strat_recoded bgid hhid;
1551          %end;
1552          weight _one_;
1553          model y_bin_gfr = x17 x12 x18 y_bmi age_strat_new x6;
1554          output beta sebeta p_beta t_beta / filename=betas_&corr. filetype=sas replace;
1555      run;
1556      * Append parameter names to sudaan output;
1557      data dt_betas.betas_pop_bin_&corr;
1558          merge betas_&corr.(rename=(BETA=Estimate SEBETA=Stderr P_BETA=ProbZ t_beta=t))
1558! parms;
1559          by modelrhs;
1560          length parm $ 20;
1561          format Estimate Stderr 12.4;
1562          drop procnum modelno modelrhs;
1563      run;
