37   ************************************************************************
37 ! *********************************
38   
39           PROGRAM NAME: combine_sudaan.sas
40           PROGRAMMER: Beibo Zhao (updated from AQA)
41           DESCRIPTION: Combine results and calculate performance metrics
41 ! for HCHS V3 simulation
42           VERSION CONTROL:
43                           - 24APR25: Initialize the code (AQA)
44                           - Aug2025: Updated for consistency with R
44 ! simulation framework (BZ)
45   ************************************************************************
45 ! *********************************;
46   
47   %macro combine_con_betas(start=, end=, corr=, corr_full = , rr=,
48                          input_lib=, pop_lib=dt_betas, output_lib=outpath)
48 ! ;
49   
50       /* Merge files containing beta estimates using sample data */
51       data merge_betas;
52           set &input_lib..&corr.&rr.&start. - &input_lib..&corr.&rr.&end.;
53           if parm = 'intercept' then parm = 'Intercept';
54       run;
55   
56       /* Append the true value coming from population estimates */
57       proc sql;
58           create table betas_samp_pop as
59           select a.*, b.estimate as true
60           from merge_betas as a
61           right join
62           &pop_lib..betas_pop_&corr. as b
63           on a.parm=b.parm;
64       quit;
65   
66       /* Compute 95% confidence intervals */
67       data betas_samp_pop;
68           set betas_samp_pop;
69           uppercl = Estimate + 1.975 * Stderr;
70           lowercl = Estimate - 1.975 * Stderr;
71       run;
72   
73       /* Estimate quantities of interest: bias, ... */
74       data betas_samp_pop_;
75           set betas_samp_pop;
76           /* Calculate statistics to summarize */
77           inci = (uppercl >= true & lowercl <= true);
78           bias = estimate - true;
79           relbias = bias / true;
80           /* PROBT */
81           rejecth0 = (abs(t) > quantile('NORMAL',.975));
82       run;
83   
84       /* Calculate summary statistics */
85       proc means data=betas_samp_pop_ noprint nway;
86           class parm;
87           var true estimate bias relbias stderr inci rejecth0;
88           output out=output_1 mean(true estimate bias relbias stderr inci
89                   rejecth0)=true estimate empbias relbias estse coverage
90                   prejecth0 std(estimate)=empse;
91       run;
92   
93       /* Final calculations */
94       data output;
95           set output_1;
96           relse = estse/empse - 1;
97       run;
98   
99       /* Save output dataset */
100      data &output_lib..&input_lib._&corr.&rr.;
101          set output;
102      run;
103  
104  
105  %mend combine_con_betas;
106  
107  
108  * s1;
109  * Complete %combine_con_betas macro calls for all scenarios;
110  
111  * miss_ind_mar scenarios;
112  %combine_con_betas(start=1, end=500, corr=ind, corr_full=independent,
112! rr=_rr_glm_,
113                   input_lib=s1);

