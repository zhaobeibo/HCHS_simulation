513    *************************************************************************
513  ! ********************************
514    
515            PROGRAM NAME: combine_sudaan.sas
516            PROGRAMMER: Beibo Zhao (updated from AQA)
517            DESCRIPTION: Combine results and calculate performance metrics
517  ! for HCHS V3 simulation
518            VERSION CONTROL:
519                            - 24APR25: Initialize the code (AQA)
520                            - Aug2025: Updated for consistency with R
520  ! simulation framework (BZ)
521                            - Modified: Handle missing datasets from 1-1000,
521  ! skip non-existent files
522    *************************************************************************
522  ! ********************************;
523    
524    %macro combine_con_betas(start=, end=, corr=, corr_full = , rr=,
525                           input_lib=, pop_lib=dt_betas, output_lib=outpath);
526    
527        /* Create a temporary dataset to hold all existing files */
528        data merge_betas;
529            /* Initialize empty dataset with correct structure */
530            length parm $20;
531            if 0; /* This creates structure but no observations */
532        run;
533    
534        /* Counter for successful merges */
535        %let merge_count = 0;
536    
537        /* Loop through each file number and check if it exists */
538        %do i = &start %to &end;
539            /* Check if dataset exists using SASHELP.VTABLE or by attempting
539  ! to open */
540            %if %sysfunc(exist(&input_lib..&corr.&rr.&i.)) %then %do;
541                /* Dataset exists, append it */
542                data merge_betas;
543                    set merge_betas &input_lib..&corr.&rr.&i.;
544                    if parm = 'intercept' then parm = 'Intercept';
545                run;
546                %let merge_count = %eval(&merge_count + 1);
547                %put NOTE: Successfully merged dataset
547  ! &input_lib..&corr.&rr.&i. (File &merge_count);
548            %end;
549            %else %do;
550                %put WARNING: Dataset &input_lib..&corr.&rr.&i. does not
550  ! exist - skipping;
551            %end;
552        %end;
553    
554        %put NOTE: Total datasets merged: &merge_count out of %eval(&end -
554  ! &start + 1) possible files;
555    
556        /* Check if we have any data to process */
557        %let dsid = %sysfunc(open(merge_betas));
558        %let nobs = %sysfunc(attrn(&dsid, nobs));
559        %let rc = %sysfunc(close(&dsid));
560    
561        %if &nobs = 0 %then %do;
562            %put ERROR: No datasets found to merge for &input_lib..&corr.&rr.
562  !  - exiting macro;
563            %return;
564        %end;
565    
566        /* Append the true value coming from population estimates */
567        proc sql;
568            create table betas_samp_pop as
569            select a.*, b.estimate as true
570            from merge_betas as a
571            right join
572            &pop_lib..betas_pop_&corr. as b
573            on a.parm=b.parm;
574        quit;
575    
576        /* Compute 95% confidence intervals */
577        data betas_samp_pop;
578            set betas_samp_pop;
579            uppercl = Estimate + 1.975 * Stderr;
580            lowercl = Estimate - 1.975 * Stderr;
581        run;
582    
583        /* Estimate quantities of interest: bias, ... */
584        data betas_samp_pop_;
585            set betas_samp_pop;
586            /* Calculate statistics to summarize */
587            inci = (uppercl >= true & lowercl <= true);
588            bias = estimate - true;
589            relbias = bias / true;
590            /* PROBT */
591            rejecth0 = (abs(t) > quantile('NORMAL',.975));
592        run;
593    
594        /* Calculate summary statistics */
595        proc means data=betas_samp_pop_ noprint nway;
596            class parm;
597            var true estimate bias relbias stderr inci rejecth0;
598            output out=output_1 mean(true estimate bias relbias stderr inci
599                    rejecth0)=true estimate empbias relbias estse coverage
600                    prejecth0 std(estimate)=empse;
601        run;
602    
603        /* Final calculations */
604        data output;
605            set output_1;
606            relse = estse/empse - 1;
607            /* Add information about number of files merged */
608            files_merged = &merge_count;
609        run;
610    
611        /* Save output dataset */
612        data &output_lib..&input_lib._&corr.&rr.;
613            set output;
614        run;
615    
616        /* Clean up temporary datasets */
617        proc datasets library=work nolist;
618            delete merge_betas betas_samp_pop betas_samp_pop_ output_1 output
618  ! ;
619        quit;
620    
621    %mend combine_con_betas;
622    
623    
624    * s1 - MI scenarios;
625    * miss_ind_mar scenarios;
626    /*%combine_con_betas(start=1, end=100, corr=ind, corr_full=independent,
626  ! rr=_double_rr_, */
627    /*                 input_lib=test1);*/
628    
629    %combine_con_betas(start=1, end=200, corr=ind, corr_full=independent,
629  ! rr=_rr_glm_mask_,
630                     input_lib=test2);

