230    *************************************************************************
230  ! ********************************
231    
232            PROGRAM NAME: combine_sudaan.sas
233            PROGRAMMER: Beibo Zhao (updated from AQA)
234            DESCRIPTION: Combine results and calculate performance metrics
234  ! for HCHS V3 simulation
235            VERSION CONTROL:
236                            - 24APR25: Initialize the code (AQA)
237                            - Aug2025: Updated for consistency with R
237  ! simulation framework (BZ)
238    *************************************************************************
238  ! ********************************;
239    
240    %macro combine_mi_betas(start=1, end=500, corr=, corr_full = , rr=,
241                           input_lib=, pop_lib=dt_betas, output_lib=outpath);
242    
243        /* Merge files containing beta estimates using sample data */
244        data merge_betas;
245            set &input_lib..&corr.&rr.&start. - &input_lib..&corr.&rr.&end.;
246            if parm = 'intercept' then parm = 'Intercept';
247        run;
248    
249        /* Append the true value coming from population estimates */
250        proc sql;
251            create table betas_samp_pop as
252            select a.*, b.estimate as true
253            from merge_betas as a
254            right join
255            &pop_lib..betas_pop_&corr. as b
256            on a.parm=b.parm;
257        quit;
258    
259        /* Compute 95% confidence intervals */
260        data betas_samp_pop;
261            set betas_samp_pop;
262            uppercl = Estimate + 1.975 * Stderr;
263            lowercl = Estimate - 1.975 * Stderr;
264        run;
265    
266        /* Estimate quantities of interest: bias, ... */
267        data betas_samp_pop_;
268            set betas_samp_pop;
269            /* Calculate statistics to summarize */
270            inci = (uppercl >= true & lowercl <= true);
271            bias = estimate - true;
272            relbias = bias / true;
273            /* PROBT */
274            rejecth0 = (abs(t) > quantile('NORMAL',.975));
275        run;
276    
277        /* Calculate summary statistics */
278        proc means data=betas_samp_pop_ noprint nway;
279            class parm;
280            var true estimate bias relbias stderr inci rejecth0;
281            output out=output_1 mean(true estimate bias relbias stderr inci
282                    rejecth0)=true estimate empbias relbias estse coverage
283                    prejecth0 std(estimate)=empse;
284        run;
285    
286        /* Final calculations */
287        data output;
288            set output_1;
289            relse = estse/empse - 1;
290        run;
291    
292        /* Save output dataset */
293        data &output_lib..&input_lib._&corr.&rr.;
294            set output;
295        run;
296    
297    
298    %mend combine_mi_betas;
299    
300    
301    * s1;
302    * Complete %combine_mi_betas macro calls for all scenarios;
303    
304    * miss_ind_mar scenarios;
305    %combine_mi_betas(corr=ind, corr_full=independent, rr=_rr_glm_,
306                     input_lib=s1);
