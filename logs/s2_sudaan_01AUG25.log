397   **************************************************************************
397 ! *******************************
398   
399           PROGRAM NAME: regress_sudaan.sas
400   
401           PROGRAMMER: AQA
402   
403           DESCRIPTION:
404   
405           VERSION CONTROL:
406                           - 20FEB25: Initialize the code
407                           - 30may25: Uncomment the miss_ind_mar = 0 so we
407 ! obtain the complete data case
408   
409   **************************************************************************
409 ! *******************************;
410   
411   * Run sudaan models for the 100 files;
412   %macro regress_sudaan(start=1, end=1000, corr=, corr_full=);
413     %do i = &start %to &end;
414   
415       * use only available data;
416       proc sql;
417           create table samplemiss_&i._ as
418           select *
419           from sample.samplemiss_&i.
420           where miss_ind_mar = 0; /* Select only records with no missingness
420 !  */
421       quit;
422   
423       * order data;
424       proc sort data = samplemiss_&i._;
425           by strat_recoded bgid hhid subid;
426       run;
427   
428       * Fit regress model from sudaan using &corr matrix;
429           * In a simulation group meeting it was requested to use hhid as
429 ! PSUs instead of bgid;
430       options pagesize=60 linesize=80;
431       proc regress data = samplemiss_&i._ filetype=sas r=&corr_full
431 ! semethod=zeger;
432           %if  &corr. = exch %then %do;
433               nest strat_recoded hhid / psulev=2 ;
434           %end;
435           %else %do;
436               nest strat_recoded hhid;
437           %end;
438           weight bghhsub_s2;
439           model y_gfr = x17 x12 x18 y_bmi age_strat_new x6;
440           output beta sebeta p_beta t_beta / filename=betas_&corr._&i._
440 ! filetype=sas replace;
441       run;
442   
443       * Append parameter names to sudaan output;
444       data dt_b_s2.&corr._&i;
445           merge betas_&corr._&i._(rename=(BETA=Estimate SEBETA=Stderr
445 ! P_BETA=ProbZ t_beta=t)) parms;
446           by modelrhs;
447           length parm $ 20;
448           drop procnum modelno modelrhs;
449       run;
450   
451     %end;
452   %mend regress_sudaan;
453   
454   * Create dataset with parms labels;
455   data parms;
456       length Parm $ 15;
457       input modelrhs parm $;
458       datalines;

NOTE: The data set WORK.PARMS has 7 observations and 2 variables.
NOTE: DATA statement used (Total process time):
      real time           0.01 seconds
      cpu time            0.01 seconds
      

466   ;
467   run;
468   
469   /* Execute the macro for exchangeable correlation matrix */
470   %regress_sudaan(corr=ind, corr_full=independent);
