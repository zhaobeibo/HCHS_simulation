1599  ;
1600  run;
1601  
1602  %macro impute_sudaan(start=, end=, corr=, corr_full=, miss=);
1603    %do i = &start. %to &end.;
1604  
1605  
1606    /*============================*
1607     | 1) Split to V1 / V2 / V3   |
1608     *============================*/
1609    data samp_1 samp_2 samp_3;
1610      set sample.samplemiss_&i;
1611      where &miss. = 0;   /* keep only non-missing per your scenario flag */
1612      if      v_num = 1 then output samp_1;
1613      else if v_num = 2 then output samp_2;
1614      else if v_num = 3 then output samp_3;
1615    run;
1616  
1617    /* Sort all three and build unique ID lists for V2/V3 */
1618    proc sort data = samp_1;                           by subid; run;
1619    proc sort data = samp_2(keep = subid) out = v2_ids nodupkey; by subid;
1619! run;
1620    proc sort data = samp_3(keep = subid) out = v3_ids nodupkey; by subid;
1620! run;
1621  
1622    /*=====================================================*
1623     | 2) Add PARTICIPANT_V2 / PARTICIPANT_V3 to the V1   |
1624     |    dataset BEFORE missingness + MI                 |
1625     *=====================================================*/
1626    data samp_1_w_flags;
1627      merge samp_1(in = in_v1)
1628            v2_ids(in = in_v2)
1629            v3_ids(in = in_v3);
1630      by subid;
1631      if in_v1;
1632  
1633      /* Raw visit participation flags (before baseline missingness) */
1634      PARTICIPANT_V2 = (in_v2 = 1);
1635      PARTICIPANT_V3 = (in_v3 = 1);
1636  
1637      /* Strata indicators: 1/0 flags */
1638      length strata1 strata2 strata3 8;
1639      strata1 = (strat in (1, 5));
1640      strata2 = (strat in (2, 6));
1641      strata3 = (strat in (3, 7));
1642    run;
1643  
1644    /* Optional: quick check */
1645    proc freq data = samp_1_w_flags;
1646      tables PARTICIPANT_V2 PARTICIPANT_V3 / missing;
1647    run;
1648  
1649    /*====================================================*
1650     | 3) Inject ~5% MCAR missingness for V1 variables    |
1651     |    AND update PARTICIPANT_V2/V3 to "analytic"      |
1652     |    flags (participation + non-missing baseline)    |
1653     *====================================================*/
1654    data samp_1_miss;
1655      set samp_1_w_flags;
1656  
1657      /* Artificial missingness in baseline predictors */
1658      array missvars age_base x12 x14;   /* variables to blank */
1659      do over missvars;
1660        if rand('uniform') < 0.10 then missvars = .;
1661      end;
1662  
1663      /* Re-define PARTICIPANT flags:
1664         1 = attended visit AND all baseline variables are non-missing */
1665      PARTICIPANT_V2_NOMISS = (PARTICIPANT_V2 = 1 and nmiss(age_base, x12,
1665! x14) = 0);
1666      PARTICIPANT_V3_NOMISS = (PARTICIPANT_V3 = 1 and nmiss(age_base, x12,
1666! x14) = 0);
1667    run;
1668  
1669    /* Optional: sanity check */
1670    proc means data = samp_1_miss n nmiss;
1671      var age_base x12 x14;
1672    run;
1673  
1674    /*========================================*
1675     | 4) Multiple Imputation on V1 dataset   |
1676     |    (baseline-only covariates)          |
1677     *========================================*/
1678    proc mi data = samp_1_miss seed = 2021 nimpute = 5 out = samp_complete;
1679      class strata1 strata2 strata3 x12 x14;
1680      var strata1 strata2 strata3 age_base x12 x14 bghhsub_s2;
1681      fcs reg(age_base);          /* continuous */
1682      fcs logistic(x12 x14);      /* binary/categorical */
1683    run;
1684  
1685    /*===========================*
1686     | 5) IPW prediction models  |
1687     *===========================*/
1688  
1689    /* = Visit 2: logistic on analytic PARTICIPANT_V2 flag = */
1690    proc logistic data = samp_complete descending noprint;
1691      by _Imputation_;
1692      class strata1 strata2 strata3 x12 x14 PARTICIPANT_V2_NOMISS;
1693      model PARTICIPANT_V2_NOMISS = strata1 strata2 strata3 age_base x12 x14
1693! ;
1694      output out = pred_v2_imp(keep = _Imputation_ subid xb_v2) xbeta =
1694! xb_v2;
1695    run;
1696  
1697    proc means data = pred_v2_imp nway noprint;
1698      class subid;
1699      var xb_v2;
1700      output out = pred_v2_bar(drop = _type_ _freq_) mean = xb_v2_bar;
1701    run;
1702  
1703    /* = Visit 3: logistic on analytic PARTICIPANT_V3 flag
1704         with baseline + PARTICIPANT_V2 only = */
1705    proc logistic data = samp_complete descending noprint;
1706      by _Imputation_;
1707      class strata1 strata2 strata3 x12 x14 PARTICIPANT_V2
1707! PARTICIPANT_V3_NOMISS;
1708      model PARTICIPANT_V3_NOMISS = strata1 strata2 strata3 age_base x12 x14
1708!  PARTICIPANT_V2;
1709      output out = pred_v3_imp(keep = _Imputation_ subid xb_v3) xbeta =
1709! xb_v3;
1710    run;
1711  
1712    proc means data = pred_v3_imp nway noprint;
1713      class subid;
1714      var xb_v3;
1715      output out = pred_v3_bar(drop = _type_ _freq_) mean = xb_v3_bar;
1716    run;
1717  
1718    /*===========================*
1719     | 6) Compute response rates |
1720     *===========================*/
1721    proc sort data = pred_v2_bar; by subid; run;
1722    proc sort data = pred_v3_bar; by subid; run;
1723  
1724    data samp_ipw;
1725      merge samp_1_miss(in = a)
1726            pred_v2_bar(rename = (xb_v2_bar = lp_v2))
1727            pred_v3_bar(rename = (xb_v3_bar = lp_v3));
1728      by subid;
1729      if a;
1730  
1731      /* Predicted response rates (probability of being in analytic set) */
1732      if not missing(lp_v2) then RR_V2 = 1 / (1 + exp(-lp_v2));
1733      if not missing(lp_v3) then RR_V3 = 1 / (1 + exp(-lp_v3));
1734    run;
1735  
1736  
1737  /* --- Starting from samp_ipw already created --- */
1738  data samp_ipw_long(keep = subid v_num PARTICIPANT_V3_NOMISS rr_glm_mask);
1739    set samp_ipw;
1740  
1741    /* Visit 1: everyone contributes */
1742    v_num = 1;
1743    rr_glm_mask = 1;
1744    output;
1745  
1746    /* Visit 2: only participants with data contribute */
1747    v_num = 2;
1748    if PARTICIPANT_V2_NOMISS = 1 then
1749      rr_glm_mask = RR_V2;
1750    else
1751      rr_glm_mask = .;
1752    output;
1753  
1754    /* Visit 3: only participants with data contribute */
1755    v_num = 3;
1756    if PARTICIPANT_V3_NOMISS = 1 then
1757      rr_glm_mask = RR_V3;
1758    else
1759      rr_glm_mask = .;
1760    output;
1761  run;
1762  
1763  
1764    proc sort data = samp_ipw_long; by subid v_num; run;
1765  
1766    /* Bring in the base sample restricted by &miss. */
1767    data sampmiss;
1768      set sample.samplemiss_&i;
1769  /*    where &miss. = 0;*/
1770    run;
1771  
1772    proc sort data = sampmiss; by subid v_num; run;
1773  
1774    /* Merge the rr_glm_mask and compute nonresponse-adjusted weight */
1775    data samp;
1776      merge sampmiss(in = a)
1777            samp_ipw_long(in = b);
1778      by subid v_num;
1779  
1780      if a;
1781  
1782      /* weight adjusted for nonresponse */
1783      bghhsub_s2_nr = bghhsub_s2 / rr_glm_mask;
1784  
1785        /* Recreate age_strat_new from age_base so missingness propagates
1786           consistently with the main model */
1787  
1788        length age_strat_new 8;
1789  
1790        if missing(age_base) then do;
1791          age_strat_new = .;
1792        end;
1793        else do;
1794          /* same as in import_sample_data.sas */
1795          age_strat_new = 1*(age_base >= 45);
1796        end;
1797  
1798    run;
1799  
1800  
1801    /* Sort samp by subid for merging */
1802    proc sort data = samp;
1803      by subid;
1804    run;
1805  
1806    /* Step 1: Create a dataset with subid in V3 */
1807    proc sql;
1808       create table valid_subid as
1809       select distinct subid
1810       from samp
1811       where v_num = 3;
1812    quit;
1813  
1814    /* Sort valid_subid by subid for merging */
1815    proc sort data = valid_subid;
1816      by subid;
1817    run;
1818  
1819    /* Step 2: Merge samp with valid_subid to keep only valid subids */
1820    data samp_filtered;
1821       merge samp(in=a) valid_subid(in=b);
1822       by subid;
1823       if b;  /* Only keep records from samp where subid is in valid_subid
1823! */
1824    run;
1825  
1826    /* Step 3: Create a dataset with the value of bghhsub_s2_nr for v_num =
1826! 3 for each subid */
1827    proc sql;
1828       create table temp as
1829       select subid, bghhsub_s2_nr as bghhsub_s2_v3_nr
1830       from samp_filtered
1831       where v_num = 3;
1832    quit;
1833  
1834    /* Step 4: Merge the new variable back into the filtered dataset */
1835    data samplemiss_&i._;
1836       merge samp_filtered temp;
1837       by subid;
1838    run;
1839  
1840    /* Order data */
1841    proc sort data = samplemiss_&i._;
1842      by strat_recoded bgid hhid subid;
1843    run;
1844  
1845  
1846    /* Fit regress model from SUDAAN using &corr matrix;
1847       In a simulation group meeting it was requested to use hhid as PSUs
1847! instead of bgid */
1848    options pagesize=60 linesize=80;
1849    proc regress data = samplemiss_&i._ filetype=sas r=&corr_full
1849! semethod=zeger;
1850      %if  &corr. = exch %then %do;
1851        nest strat_recoded hhid / psulev=2 ;
1852      %end;
1853      %else %do;
1854        nest strat_recoded hhid;
1855      %end;
1856      weight bghhsub_s2_v3_nr;    * use visit-3 adjusted weight;
1857      subpopn PARTICIPANT_V3_NOMISS = 1;
1858      model y_gfr = x17 x12 x18 y_bmi age_strat_new x6;
1859      output beta sebeta p_beta t_beta / filename=betas_&corr._&i._
1859! filetype=sas replace;
1860    run;
1861  
1862    /* Append parameter names to SUDAAN output */
1863    data test2.&corr._rr_glm_mask_&i;
1864      merge betas_&corr._&i._(rename=(BETA=Estimate SEBETA=Stderr
1864! P_BETA=ProbZ t_beta=t)) parms;
1865      by modelrhs;
1866      length parm $ 20;
1867      format Estimate Stderr 12.4;
1868      drop procnum modelno modelrhs;
1869    run;
1870  
1871    %end;
1872  %mend impute_sudaan;
1873  
1874  * miss_ind_mar;
1875  %impute_sudaan(start=1, end=200, corr=ind, corr_full=independent, miss=
1875! miss_ind_mar);

